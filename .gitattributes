# Default: normalize all text to LF in the repo
* text=auto eol=lf
*.sh text eol=lf
*.py text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.md text eol=lf

# Binary files — never touch
*.png binary
*.jpg binary
*.pdf binary
*.gguf binary
*.safetensors binary
*.db binary

# Shell scripts always LF
*.sh text eol=lf

# Odoo XML/Python always LF
*.py text eol=lf
*.xml text eol=lf
*.csv text eol=lf
