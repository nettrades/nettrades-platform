{
  "name": "nettrades-launcher",
  "version": "1.0.0",
  "description": "NETTRADES Launcher – Sovereign AI Control Centre for Autonomous Enterprises",
  "main": "main.js",
  "homepage": "https://nettrades.ai",
  "author": "NETTRADES.AI",
  "license": "AGPL-3.0",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "build:linux": "electron-builder --linux --publish never",
    "build:all": "electron-builder -mwl --publish never",
    "release": "electron-builder -mwl --publish always",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "electron": "^37.2.3",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "sudo-prompt": "^9.2.1",
    "electron-updater": "^6.3.9",
    "bonjour": "^3.5.0",
    "axios": "^1.7.2"
  },
  "build": {
    "appId": "ai.nettrades.launcher",
    "productName": "NETTRADES Launcher",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "build/**/*"
    ],
    "extraResources": [
      {
        "from": "../scripts/",
        "to": "scripts/",
        "filter": ["*.sh"]
      },
      {
        "from": "../deploy/docker/",
        "to": "deploy/docker/",
        "filter": ["docker-compose.yaml", ".env.example"]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "nettrades",
        "repo": "nettrades-platform",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NETTRADES Launcher",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "license": "LICENSE.txt"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "build/icon.png",
      "category": "Development"
    },
    "deb": {
      "afterInstall": "scripts/postinstall.sh",
      "depends": ["docker.io", "docker-compose", "bash"]
    }
  }
}