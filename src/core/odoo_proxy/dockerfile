# =============================================================================
# FILE: src/core/odoo_proxy/Dockerfile
# =============================================================================
# DESCRIPTION:
#   Container definition for the Odoo HTTP Proxy Shim.
#   This service is a lightweight FastAPI wrapper that forwards JSON-RPC
#   calls from the LangGraph service to the Odoo backend.
#
# USAGE:
#   docker build -t odoo-proxy -f Dockerfile .
#   docker run -p 8080:8080 -e PROXY_API_KEY=... -e ODOO_PASSWORD=... odoo-proxy
# =============================================================================

FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Install dependencies
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Copy source
COPY . .

# Expose port
EXPOSE 8080

# Healthcheck
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:8080/health')" || exit 1

# Start uvicorn
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8080"]