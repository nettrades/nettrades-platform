# =============================================================================
# Odoo JSON-RPC Proxy Dockerfile
# =============================================================================
# FILE: src/core/odoo_proxy/Dockerfile
#
# PURPOSE:
#   Builds a lightweight container for the Odoo JSON-RPC proxy.
#
# =============================================================================

FROM python:3.12-slim

WORKDIR /app

# Install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy source code
COPY main.py .

# Expose port
EXPOSE 3000

# Run the proxy
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "3000"]