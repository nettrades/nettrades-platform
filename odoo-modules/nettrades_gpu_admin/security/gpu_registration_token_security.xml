<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="gpu_registration_token_company_rule" model="ir.rule">
        <field name="name">GPU Registration Token: Company Isolation</field>
        <field name="model_id" ref="model_gpu_registration_token"/>
        <field name="global" eval="False"/>
        <field name="domain_force">[('company_id', 'in', user.company_ids)]</field>
        <field name="groups" eval="[(4, ref('nettrades_gpu_admin.group_gpu_administrator')), (4, ref('nettrades_gpu_admin.group_gpu_operator'))]"/>
    </record>
</odoo>