<?xml version="1.0" encoding="utf-8"?>
<!--
    NETTRADES GPU Admin – Security Groups
    =====================================
    Defines two user groups:
      • GPU Administrator – full control over GPU clusters and nodes.
      • GPU Operator – read-only access to GPU cluster status.
    Record rules ensure that each company's administrators only see their
    own company's GPU resources.
-->
<odoo>
    <!-- GPU Administrator group -->
    <record id="group_gpu_administrator" model="res.groups">
        <field name="name">GPU Administrator</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <!-- GPU Operator group (read-only) -->
    <record id="group_gpu_operator" model="res.groups">
        <field name="name">GPU Operator</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Record rule: GPU administrators see only their own company's clusters -->
    <record id="rule_gpu_cluster_company" model="ir.rule">
        <field name="name">GPU Cluster: Company Only</field>
        <field name="model_id" ref="model_gpu_cluster"/>
        <field name="domain_force">[('company_id', '=', user.company_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_gpu_administrator'))]"/>
    </record>

    <!-- Record rule: GPU nodes are limited to the cluster's company -->
    <record id="rule_gpu_node_company" model="ir.rule">
        <field name="name">GPU Node: Company Only</field>
        <field name="model_id" ref="model_gpu_node"/>
        <field name="domain_force">[('cluster_id.company_id', '=', user.company_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_gpu_administrator'))]"/>
    </record>
</odoo>