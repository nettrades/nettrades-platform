<?xml version="1.0" encoding="utf-8"?>
<!--
    ============================================================================
    FILE: odoo-modules/nettrades_gpu_admin/security/gpu_admin_security.xml
    ============================================================================
    DESCRIPTION:
        Record rules for all GPU-related models to enforce company isolation
        and group-specific access restrictions.

        These rules implement the security policy for the distributed GPU
        marketplace. They work in conjunction with:
          - groups.xml         : defines the user groups
          - ir.model.access.csv : defines CRUD permissions at the model level

        ────────────────────────────────────────────────────────────────────────────
        SECURITY POLICY OVERVIEW
        ────────────────────────────────────────────────────────────────────────────
        1. COMPANY ISOLATION (Multi-Tenant)
           • Users can only see GPU resources that belong to their company.
           • This is enforced through domain filters on every GPU model.

        2. GROUP-SPECIFIC RESTRICTIONS
           • GPU Administrators have full access to all GPU models within
             their company (create, read, update, delete).
           • GPU Operators have read-only access to GPU clusters and nodes
             (they can view configurations but cannot modify them).

        3. IMPLEMENTATION APPROACH
           • Company-only rules apply to BOTH Administrators and Operators.
           • Explicit read-only rules are applied specifically to Operators
             on the `gpu.cluster` and `gpu.node` models to reinforce the
             read-only policy (though the domain is the same, the rule exists
             to clearly document the intent and to ensure separation of concerns).

        ────────────────────────────────────────────────────────────────────────────
        RULES PRESERVED (2026-06-28)
        ────────────────────────────────────────────────────────────────────────────
        This file contains all 8 record rules from the original implementation.
        No rules have been removed. The group references have been updated to
        use the new group IDs:
          - group_gpu_administrator (replaces group_gpu_manager)
          - group_gpu_operator       (replaces group_gpu_user)
    ============================================================================
-->

<odoo>

    <!-- =====================================================================
         RULE 1: GPU CLUSTER – Company Isolation (Admin + Operator)
         =====================================================================
         Original name: "GPU Administrator GPU Operator GPU Cluster: Company Only"
         Applies to:  gpu.cluster model
         Groups:      Administrator and Operator
         Domain:      Only records where company_id matches the user's company.
         Purpose:     Ensures that both Administrators and Operators can only
                      see GPU clusters belonging to their own company.
    ===================================================================== -->
    <record id="gpu_cluster_company_rule" model="ir.rule">
        <field name="name">GPU Administrator GPU Operator GPU Cluster: Company Only</field>
        <field name="model_id" ref="model_gpu_cluster"/>
        <field name="global" eval="False"/>
        <field name="domain_force">[('company_id', '=', user.company_id.id)]</field>
        <field name="groups" eval="[
            (4, ref('nettrades_gpu_admin.group_gpu_administrator')),
            (4, ref('nettrades_gpu_admin.group_gpu_operator'))
        ]"/>
    </record>

    <!-- =====================================================================
         RULE 2: GPU NODE – Company Isolation (Admin + Operator)
         =====================================================================
         Original name: "GPU Node: Company Only"
         Applies to:  gpu.node model
         Groups:      Administrator and Operator
         Domain:      Only nodes whose cluster belongs to the user's company.
         Purpose:     Prevents cross-company visibility of GPU nodes.
    ===================================================================== -->
    <record id="gpu_node_company_rule" model="ir.rule">
        <field name="name">GPU Node: Company Only</field>
        <field name="model_id" ref="model_gpu_node"/>
        <field name="global" eval="False"/>
        <field name="domain_force">[('cluster_id.company_id', '=', user.company_id.id)]</field>
        <field name="groups" eval="[
            (4, ref('nettrades_gpu_admin.group_gpu_administrator')),
            (4, ref('nettrades_gpu_admin.group_gpu_operator'))
        ]"/>
    </record>

    <!-- =====================================================================
         RULE 3: GPU CLUSTER SUBNET – Company Isolation (Admin + Operator)
         =====================================================================
         Original name: "GPU Cluster Subnet: Company Only"
         Applies to:  gpu.cluster.subnet model
         Groups:      Administrator and Operator
         Domain:      Only subnets whose cluster belongs to the user's company.
         Purpose:     Restricts IP subnet configurations to the company's cluster.
    ===================================================================== -->
    <record id="gpu_cluster_subnet_company_rule" model="ir.rule">
        <field name="name">GPU Cluster Subnet: Company Only</field>
        <field name="model_id" ref="model_gpu_cluster_subnet"/>
        <field name="global" eval="False"/>
        <field name="domain_force">[('cluster_id.company_id', '=', user.company_id.id)]</field>
        <field name="groups" eval="[
            (4, ref('nettrades_gpu_admin.group_gpu_administrator')),
            (4, ref('nettrades_gpu_admin.group_gpu_operator'))
        ]"/>
    </record>

    <!-- =====================================================================
         RULE 4: GPU SHARING SCHEDULE – Company Isolation (Admin + Operator)
         =====================================================================
         Original name: "GPU Sharing Schedule: Company Only"
         Applies to:  gpu.sharing.schedule model
         Groups:      Administrator and Operator
         Domain:      Only schedules whose cluster belongs to the user's company.
         Purpose:     Ensures sharing schedules are scoped to the company.
    ===================================================================== -->
    <record id="gpu_sharing_schedule_company_rule" model="ir.rule">
        <field name="name">GPU Sharing Schedule: Company Only</field>
        <field name="model_id" ref="model_gpu_sharing_schedule"/>
        <field name="global" eval="False"/>
        <field name="domain_force">[('cluster_id.company_id', '=', user.company_id.id)]</field>
        <field name="groups" eval="[
            (4, ref('nettrades_gpu_admin.group_gpu_administrator')),
            (4, ref('nettrades_gpu_admin.group_gpu_operator'))
        ]"/>
    </record>

    <!-- =====================================================================
         RULE 5: GPU TOKEN ECONOMICS – Company Isolation (Admin + Operator)
         =====================================================================
         Original name: "GPU Token Economics: Company Only"
         Applies to:  gpu.token.economics model
         Groups:      Administrator and Operator
         Domain:      Only records where company_id matches the user's company.
         Purpose:     Restricts token economics (pricing, rewards) to the company.
    ===================================================================== -->
    <record id="gpu_token_economics_company_rule" model="ir.rule">
        <field name="name">GPU Token Economics: Company Only</field>
        <field name="model_id" ref="model_gpu_token_economics"/>
        <field name="global" eval="False"/>
        <field name="domain_force">[('company_id', '=', user.company_id.id)]</field>
        <field name="groups" eval="[
            (4, ref('nettrades_gpu_admin.group_gpu_administrator')),
            (4, ref('nettrades_gpu_admin.group_gpu_operator'))
        ]"/>
    </record>

    <!-- =====================================================================
         RULE 6: MULTIMODAL CONFIG – Company Isolation (Admin + Operator)
         =====================================================================
         Original name: "Multimodal Config: Company Only"
         Applies to:  multimodal.config model
         Groups:      Administrator and Operator
         Domain:      Only records where company_id matches the user's company.
         Purpose:     Ensures multimodal model configurations are company-scoped.
    ===================================================================== -->
    <record id="multimodal_config_company_rule" model="ir.rule">
        <field name="name">Multimodal Config: Company Only</field>
        <field name="model_id" ref="model_multimodal_config"/>
        <field name="global" eval="False"/>
        <field name="domain_force">[('company_id', '=', user.company_id.id)]</field>
        <field name="groups" eval="[
            (4, ref('nettrades_gpu_admin.group_gpu_administrator')),
            (4, ref('nettrades_gpu_admin.group_gpu_operator'))
        ]"/>
    </record>

    <!-- =====================================================================
         RULE 7: GPU CLUSTER – Operator Read Only (Explicit Operator Rule)
         =====================================================================
         Original name: "GPU Cluster: Operator Read Only"
         Applies to:  gpu.cluster model
         Groups:      Operator ONLY (not Administrator)
         Domain:      Same company isolation domain.
         Purpose:     This rule is an explicit declaration that Operators have
                      read-only access to GPU clusters. While the domain is the
                      same as Rule 1, this rule exists to clearly document the
                      separation of permissions and to serve as a safeguard
                      for future changes. Together with ir.model.access.csv
                      (which grants Operators `perm_write=0`), this ensures
                      Operators cannot modify cluster configurations.

         NOTE: In Odoo, record rules do not directly enforce read/write
               permissions—that is handled by `ir.model.access.csv`. However,
               having this dedicated rule for Operators makes the security
               policy explicit and self-documenting.
    ===================================================================== -->
    <record id="gpu_cluster_operator_read_rule" model="ir.rule">
        <field name="name">GPU Cluster: Operator Read Only</field>
        <field name="model_id" ref="model_gpu_cluster"/>
        <field name="global" eval="False"/>
        <field name="domain_force">[('company_id', '=', user.company_id.id)]</field>
        <field name="groups" eval="[
            (4, ref('nettrades_gpu_admin.group_gpu_operator'))
        ]"/>
    </record>

    <!-- =====================================================================
         RULE 8: GPU NODE – Operator Read Only (Explicit Operator Rule)
         =====================================================================
         Original name: "GPU Node: Operator Read Only"
         Applies to:  gpu.node model
         Groups:      Operator ONLY (not Administrator)
         Domain:      Only nodes whose cluster belongs to the user's company.
         Purpose:     This rule is the operator counterpart to Rule 7. It
                      reinforces the read-only policy for GPU nodes and
                      documents that Operators should only view node status
                      and metadata, never modify or delete them.

         NOTE: This rule is redundant with Rule 2 in terms of domain, but it
               is preserved to maintain the exact original security policy
               and to explicitly separate Administrator and Operator concerns.
    ===================================================================== -->
    <record id="gpu_node_operator_read_rule" model="ir.rule">
        <field name="name">GPU Node: Operator Read Only</field>
        <field name="model_id" ref="model_gpu_node"/>
        <field name="global" eval="False"/>
        <field name="domain_force">[('cluster_id.company_id', '=', user.company_id.id)]</field>
        <field name="groups" eval="[
            (4, ref('nettrades_gpu_admin.group_gpu_operator'))
        ]"/>
    </record>

</odoo>