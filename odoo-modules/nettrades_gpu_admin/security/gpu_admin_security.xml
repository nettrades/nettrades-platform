<?xml version="1.0" encoding="utf-8"?>
<!--
    ============================================================================
    NETTRADES GPU Admin – Security Groups and Record Rules
    ============================================================================
    FILE:    odoo-modules/nettrades_gpu_admin/security/gpu_admin_security.xml
    VERSION: 1.0 (fully commented)

    PURPOSE:
        This file defines the security model for the GPU Admin module. It
        implements role-based access control (RBAC) and multi-tenant
        isolation using Odoo's built-in security groups and record rules.

        The module has two user roles:
          • GPU Administrator – full CRUD access to all GPU resources
            within their own company.
          • GPU Operator – read-only access to GPU status and monitoring
            within their own company.

        Record rules ensure that users can only see and modify GPU resources
        (clusters, nodes, schedules, etc.) that belong to their company.
        This is critical for a multi-tenant environment where multiple
        companies share the same Odoo instance.

    HOW ODOO SECURITY WORKS:
        Odoo security consists of three layers:
          1. Groups (res.groups) – assign permissions to users.
          2. Access Rights (ir.model.access.csv) – control CRUD per model.
          3. Record Rules (ir.rule) – restrict access to specific records
             using a domain filter.

        This file focuses on groups and record rules. Access rights are
        defined separately in ir.model.access.csv.

    WHEN MODIFYING THIS FILE:
        - Add new groups with a clear name and category.
        - For each new model, create record rules for both Administrator
          and Operator groups.
        - Always use company-based filtering to preserve multi-tenancy.
        - Test with users from different companies before deploying.

    ============================================================================
-->
<odoo>

    <!-- ======================================================================
        1. GPU ADMINISTRATOR GROUP
        ====================================================================== -->
    <record id="group_gpu_administrator" model="res.groups">
        <!--
            NAME:
                The human-readable name displayed in the Odoo interface
                (e.g., when assigning users to the group).
        -->
        <field name="name">GPU Administrator</field>

        <!--
            CATEGORY:
                Groups are organised into categories. We use the "Hidden"
                category to prevent these groups from appearing in the
                standard "Settings → Users & Companies → Groups" menu
                unless "Technical Features" is enabled. This keeps the UI
                cleaner for non-technical administrators.

                Alternatives:
                  - base.module_category_tools – visible to all users
                  - base.module_category_hidden – hidden from casual view
                  - base.module_category_extra – hidden but available
        -->
        <field name="category_id" ref="base.module_category_hidden"/>

        <!--
            IMPLIED_IDS (Implied Groups):
                This makes the group inherit the permissions of `base.group_user`.
                Without this, GPU administrators would not be able to access
                standard Odoo models (e.g., res.users, res.company) that they
                need to see which company they belong to.

                IMPORTANT: We do NOT give `base.group_system` to avoid granting
                full administrative rights. GPU administrators are not system
                administrators; they only have full control over GPU resources.
        -->
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>

        <!--
            USERS:
                We intentionally do NOT hardcode `base.user_admin` here.
                This prevents accidentally granting GPU administrator rights
                to all Odoo administrators. Instead, the system administrator
                should manually assign GPU administrators via the user
                form (Settings → Users & Companies → Users → edit user's
                Access Rights tab). This is a security best practice.
        -->
        <!-- <field name="users" eval="[(4, ref('base.user_admin'))]"/> -->
    </record>

    <!-- ======================================================================
        2. GPU OPERATOR GROUP (read-only)
        ====================================================================== -->
    <record id="group_gpu_operator" model="res.groups">
        <field name="name">GPU Operator</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- ======================================================================
        3. RECORD RULES – GPU ADMINISTRATOR (Full Access within Company)
        ======================================================================

        Record rules restrict which database rows a user can see and/or modify.
        The `domain_force` is a domain (Odoo's filter syntax) that is applied
        as an additional WHERE clause to every query on that model.

        Why these rules are necessary:
            Without them, a GPU administrator from Company A would be able to
            see and modify Company B's GPU clusters, nodes, and configurations.
            This would be a serious data leak and operational risk.

        How the domain works:
            - `('company_id', '=', user.company_id.id)` – restricts to records
              where the `company_id` field matches the current user's company.
            - For models that don't have a direct `company_id` (like gpu.node),
              we use a traversal: `('cluster_id.company_id', '=', user.company_id.id)`.

        PERMISSIONS:
            We explicitly set `perm_read`, `perm_write`, `perm_create`, and
            `perm_unlink` to `True` for administrators. While these are already
            granted by access rights, explicitly setting them here ensures that
            even if access rights change, the record rule still enforces the
            company restriction.
    -->

    <!-- 3.1 GPU Cluster -->
    <record id="rule_gpu_cluster_company" model="ir.rule">
        <field name="name">GPU Cluster: Company Only</field>
        <field name="model_id" ref="model_gpu_cluster"/>
        <field name="domain_force">[('company_id', '=', user.company_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_gpu_administrator'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- 3.2 GPU Node – uses cluster_id.company_id to propagate company restriction -->
    <record id="rule_gpu_node_company" model="ir.rule">
        <field name="name">GPU Node: Company Only</field>
        <field name="model_id" ref="model_gpu_node"/>
        <field name="domain_force">[('cluster_id.company_id', '=', user.company_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_gpu_administrator'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- 3.3 GPU Cluster Subnet -->
    <record id="rule_gpu_cluster_subnet_company" model="ir.rule">
        <field name="name">GPU Cluster Subnet: Company Only</field>
        <field name="model_id" ref="model_gpu_cluster_subnet"/>
        <field name="domain_force">[('cluster_id.company_id', '=', user.company_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_gpu_administrator'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- 3.4 GPU Sharing Schedule -->
    <record id="rule_gpu_sharing_schedule_company" model="ir.rule">
        <field name="name">GPU Sharing Schedule: Company Only</field>
        <field name="model_id" ref="model_gpu_sharing_schedule"/>
        <field name="domain_force">[('cluster_id.company_id', '=', user.company_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_gpu_administrator'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- 3.5 GPU Token Economics – has direct company_id -->
    <record id="rule_gpu_token_economics_company" model="ir.rule">
        <field name="name">GPU Token Economics: Company Only</field>
        <field name="model_id" ref="model_gpu_token_economics"/>
        <field name="domain_force">[('company_id', '=', user.company_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_gpu_administrator'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- 3.6 Multimodal Config – also has direct company_id -->
    <record id="rule_multimodal_config_company" model="ir.rule">
        <field name="name">Multimodal Config: Company Only</field>
        <field name="model_id" ref="model_multimodal_config"/>
        <field name="domain_force">[('company_id', '=', user.company_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_gpu_administrator'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- ======================================================================
        4. RECORD RULES – GPU OPERATOR (Read-only within Company)
        ======================================================================

        For operators, we grant only `perm_read=True`. All other CRUD actions
        are explicitly set to `False`. This makes the rule defensive and clear.

        Why this is important:
            Even if an operator were given `write` access by a poorly configured
            access right, this record rule would still block the write operation
            because the domain_force would restrict it and the record rule would
            not allow writes.
    -->

    <!-- 4.1 GPU Cluster: Operators can read their company's clusters -->
    <record id="rule_gpu_cluster_operator" model="ir.rule">
        <field name="name">GPU Cluster: Operator Read Only</field>
        <field name="model_id" ref="model_gpu_cluster"/>
        <field name="domain_force">[('company_id', '=', user.company_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_gpu_operator'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- 4.2 GPU Node -->
    <record id="rule_gpu_node_operator" model="ir.rule">
        <field name="name">GPU Node: Operator Read Only</field>
        <field name="model_id" ref="model_gpu_node"/>
        <field name="domain_force">[('cluster_id.company_id', '=', user.company_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_gpu_operator'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- 4.3 GPU Cluster Subnet -->
    <record id="rule_gpu_cluster_subnet_operator" model="ir.rule">
        <field name="name">GPU Cluster Subnet: Operator Read Only</field>
        <field name="model_id" ref="model_gpu_cluster_subnet"/>
        <field name="domain_force">[('cluster_id.company_id', '=', user.company_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_gpu_operator'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- 4.4 GPU Sharing Schedule -->
    <record id="rule_gpu_sharing_schedule_operator" model="ir.rule">
        <field name="name">GPU Sharing Schedule: Operator Read Only</field>
        <field name="model_id" ref="model_gpu_sharing_schedule"/>
        <field name="domain_force">[('cluster_id.company_id', '=', user.company_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_gpu_operator'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- 4.5 GPU Token Economics -->
    <record id="rule_gpu_token_economics_operator" model="ir.rule">
        <field name="name">GPU Token Economics: Operator Read Only</field>
        <field name="model_id" ref="model_gpu_token_economics"/>
        <field name="domain_force">[('company_id', '=', user.company_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_gpu_operator'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- 4.6 Multimodal Config -->
    <record id="rule_multimodal_config_operator" model="ir.rule">
        <field name="name">Multimodal Config: Operator Read Only</field>
        <field name="model_id" ref="model_multimodal_config"/>
        <field name="domain_force">[('company_id', '=', user.company_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_gpu_operator'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- ======================================================================
        5. NOTES FOR FUTURE DEVELOPERS
        ======================================================================

        - If you add a new GPU-related model, remember to add record rules
          for both Administrator and Operator groups.

        - The model references (e.g., `model_gpu_cluster`) are automatically
          generated by Odoo. The naming convention is:
            model_ + model_name.replace('.', '_')
          So for `gpu.cluster.subnet`, the reference is `model_gpu_cluster_subnet`.

        - If a model does not have a direct `company_id`, always use the
          relationship traversal to the cluster (or company owner) to enforce
          multi-tenancy.

        - When testing, always use at least two companies with different
          administrators to verify that they cannot see each other's records.
    -->

</odoo>