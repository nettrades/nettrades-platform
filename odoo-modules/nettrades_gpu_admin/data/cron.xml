<?xml version="1.0" encoding="utf-8"?>
<!--
    NETTRADES GPU Admin - Autonomous Cron Jobs
    ==========================================
    FILE: odoo-modules/nettrades_gpu_admin/data/cron.xml

    PURPOSE:
      Two scheduled jobs:
        1. GPU Health Watchdog - runs every hour, marks stale nodes
           offline and creates an activity for any node that has been
           offline for more than a day.
        2. High GPU Utilisation Alert - runs every 3 hours, alerts the
           GPU administrator group when all internal-pool GPUs are above
           90% utilisation (indicating the pool is saturated).

    ODOO 17+ / 19 NOTE:
      The fields `numbercall` and `doall` were REMOVED from `ir.cron`
      in Odoo 17. A cron now runs indefinitely while `active=True`. If
      `numbercall` or `doall` are present, Odoo raises:
          ValueError: Invalid field 'numbercall' in 'ir.cron'

      The `code` field is now a related field that writes through to an
      auto-created `ir.actions.server` record. Setting it in XML is still
      supported and is the canonical way to define cron jobs in Odoo 19.

    NOUPDATE:
      `noupdate="1"` is preserved. This means edits to this file will not
      overwrite an existing cron record on module upgrade — the operator
      is free to adjust the interval or disable a job from the UI without
      it being reset on the next module update.
-->
<odoo>
    <!-- =====================================================================
         GPU ADMIN CRON JOBS
         ===================================================================== -->
    <data noupdate="1">

        <!-- =================================================================
             GPU HEALTH WATCHDOG
             =================================================================
             Runs hourly. Walks all gpu.node records with status='online'
             and downgrades any whose last_seen is older than the
             configured threshold. Also creates an Odoo activity on the
             node when it has been offline for more than one day.

             Implementation: gpu.node._cron_health_watchdog()
             ================================================================= -->
        <record id="cron_gpu_health_watchdog" model="ir.cron">
            <field name="name">GPU Health Watchdog</field>
            <field name="model_id" ref="model_gpu_node"/>
            <field name="state">code</field>
            <field name="code">model._cron_health_watchdog()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

        <!-- =================================================================
             HIGH GPU UTILISATION ALERT
             =================================================================
             Runs every 3 hours. Alerts the GPU administrator group when
             every online internal-pool GPU is above 90% utilisation.
             This signals that the company's own capacity is saturated and
             that overflow to the marketplace (or a new node) should be
             considered.

             Implementation: gpu.node._cron_high_utilisation_alert()
             ================================================================= -->
        <record id="cron_gpu_utilisation_alert" model="ir.cron">
            <field name="name">High GPU Utilisation Alert</field>
            <field name="model_id" ref="model_gpu_node"/>
            <field name="state">code</field>
            <field name="code">model._cron_high_utilisation_alert()</field>
            <field name="interval_number">3</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>