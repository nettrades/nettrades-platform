<?xml version="1.0" encoding="utf-8"?>
<!--
    NETTRADES GPU Admin – Autonomous Cron Jobs
    ==========================================
    GPU Health Watchdog: runs every hour, creates an Odoo activity for any
    node that has been offline for more than 1 day.
    High GPU Utilisation Alert: runs every 3 hours, alerts when all internal
    pool GPUs are above 90% utilisation.
-->
<odoo>
    <!-- =====================================================================
         GPU ADMIN CRON JOBS
         ===================================================================== -->
    <data noupdate="1">
        <!-- GPU Health Watchdog - runs every hour -->
        <record id="cron_gpu_health_watchdog" model="ir.cron">
            <field name="name">GPU Health Watchdog</field>
            <field name="model_id" ref="model_gpu_node"/>
            <field name="code">model._cron_health_watchdog()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="True"/>
            <field name="state">code</field>
            <field name="active" eval="True"/>
        </record>

        <!-- High GPU Utilisation Alert - runs every 3 hours -->
        <record id="cron_gpu_utilisation_alert" model="ir.cron">
            <field name="name">High GPU Utilisation Alert</field>
            <field name="model_id" ref="model_gpu_node"/>
            <field name="code">model._cron_high_utilisation_alert()</field>
            <field name="interval_number">3</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="True"/>
            <field name="state">code</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>