<?xml version="1.0" encoding="utf-8"?>
<!--
    GPU Manager Dashboard – Owl template used by the JavaScript component.
    Shows a real-time summary of all GPU nodes, sharing schedules, and
    WireGuard peers.  The "Fine-Tuning" panel appears only for trusted clusters.
    FUTURE IMPROVEMENT: add a live graph of GPU utilisation.
-->
<odoo>
    <!-- =====================================================================
         GPU DASHBOARD TEMPLATES (QWeb)
         ===================================================================== -->
    <template id="gpu_dashboard" name="GPU Dashboard">
        <div class="gpu-dashboard">
            <div class="row">
                <div class="col-12">
                    <h2>GPU Cluster Manager</h2>
                </div>
            </div>
            <div class="row">
                <div class="col-6">
                    <div class="card">
                        <div class="card-header">
                            <h4>Pool A – Internal (Trusted Multi-GPU)</h4>
                        </div>
                        <div class="card-body">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Hostname</th>
                                        <th>GPUs</th>
                                        <th>VRAM (GB)</th>
                                        <th>Status</th>
                                        <th>Uptime</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="nodes_internal" t-as="node">
                                        <tr>
                                            <td><t t-esc="node.name"/></td>
                                            <td><t t-esc="node.gpu_count"/></td>
                                            <td><t t-esc="node.total_vram_gb"/></td>
                                            <td><span class="badge" t-attf-class="#{node.status == 'online' ? 'badge-success' : 'badge-danger'}"><t t-esc="node.status"/></span></td>
                                            <td><t t-esc="node.uptime_hours"/>h</td>
                                            <td>
                                                <button class="btn btn-sm btn-danger" t-att-data-id="node.id">Remove</button>
                                                <button class="btn btn-sm btn-warning" t-att-data-id="node.id">Reassign</button>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="card">
                        <div class="card-header">
                            <h4>Pool B – Public Sharing</h4>
                        </div>
                        <div class="card-body">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Hostname</th>
                                        <th>GPUs</th>
                                        <th>Tokens Served</th>
                                        <th>Earnings</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="nodes_public" t-as="node">
                                        <tr>
                                            <td><t t-esc="node.name"/></td>
                                            <td><t t-esc="node.gpu_count"/></td>
                                            <td><t t-esc="node.tokens_served"/></td>
                                            <td><t t-esc="node.token_earnings"/></td>
                                            <td><span class="badge" t-attf-class="#{node.status == 'online' ? 'badge-success' : 'badge-danger'}"><t t-esc="node.status"/></span></td>
                                            <td>
                                                <button class="btn btn-sm btn-danger" t-att-data-id="node.id">Remove</button>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </template>

    <template id="gpu_dashboard_actions" name="GPU Dashboard Actions">
        <div class="gpu-dashboard-actions">
            <button class="btn btn-primary">Scan Network</button>
            <button class="btn btn-success">Add Node</button>
        </div>
    </template>

</odoo>