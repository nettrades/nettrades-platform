<?xml version="1.0" encoding="utf-8"?>
<!--
    NETTRADES GPU Admin – Cluster Views
    ====================================
    This is the main configuration screen for a company GPU cluster.
    The administrator can set trust mode, WireGuard parameters,
    view connected GPU nodes, configure token economics, and
    launch fine-tuning jobs.
    FUTURE IMPROVEMENT: add a "Test WireGuard Connection" button.
-->
<odoo>
    <!-- =====================================================================
         GPU CLUSTER VIEWS
         ===================================================================== -->
    <record id="view_gpu_cluster_tree" model="ir.ui.view">
        <field name="name">gpu.cluster.tree</field>
        <field name="model">gpu.cluster</field>
        <field name="arch" type="xml">
            <list string="GPU Clusters">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="wireguard_mesh_subnet"/>
                <field name="trust_mode" widget="badge"/>
                <field name="status" widget="badge"/>
                <field name="node_count" sum="Total"/>
                <field name="active" widget="boolean"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_gpu_cluster_form" model="ir.ui.view">
        <field name="name">gpu.cluster.form</field>
        <field name="model">gpu.cluster</field>
        <field name="arch" type="xml">
            <form string="GPU Cluster Configuration">
                <header>
                    <button name="action_scan_network" string="Scan Network" type="object" class="btn-primary" help="Scans the network for new GPU nodes and registers them automatically."/>
                    <button name="action_generate_controller_keys" string="Generate WireGuard Keys" type="object" help="Generates a new WireGuard key pair for the cluster controller. This will overwrite existing keys."/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,active,archived"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Cluster Name..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="trust_mode" help="Select 'Trusted Multi-GPU' for internal company clusters, or 'Untrusted Public' for freelancer/ public sharing pools."/>
                            <field name="active" help="Uncheck to archive this cluster (nodes will be deactivated)."/>
                        </group>
                        <group>
                            <field name="wireguard_mesh_subnet" help="The IP subnet for the WireGuard mesh network (e.g., 10.0.0.0/24). Must not overlap with other networks."/>
                            <field name="controller_endpoint" placeholder="Public IP or DNS:51820" help="The public endpoint (IP:port) of the WireGuard controller."/>
                            <field name="wireguard_controller_public_key" help="The WireGuard public key of the cluster controller (generated automatically)."/>
                            <field name="gpustack_server_url" placeholder="http://gpustack:8000" help="URL of the GPUStack server for worker registration."/>
                            <field name="gpustack_api_key" password="True" help="API key for authenticating with GPUStack."/>
                        </group>
                    </group>
                    <notebook>
                        <!-- Configuration -->
                        <page string="Configuration">
                            <group string="Trust Mode &amp; GPUStack">
                                <field name="trust_mode"
                                       help="Trusted – Multi-GPU: full WireGuard mesh, allows NCCL across nodes, gVisor isolation recommended. Untrusted – Public Sharing: hub-and-spoke WireGuard, gVisor isolation required."/>
                                <field name="gpustack_server_url"
                                       help="URL of the GPUStack server (e.g. http://gpustack:80)."/>
                                <field name="gpustack_api_key" password="True"
                                       help="API key used to authenticate with GPUStack."/>
                            </group>
                            <div class="text-muted" colspan="2">
                                <p><b>Next steps after creating the cluster:</b></p>
                                <ul>
                                    <li>Use the <b>Scan Network</b> button to discover GPU-equipped machines.</li>
                                    <li>Configure the <b>WireGuard</b> tab to generate controller keys and set the mesh subnet.</li>
                                    <li>Visit <b>GPU Manager → Multi-Modal &amp; Edge Settings</b> to enable vision, robotics, IoT, or edge-device features.</li>
                                </ul>
                            </div>
                        </page>

                        <!-- WireGuard -->
                        <page string="WireGuard">
                            <group string="Mesh Configuration">
                                <field name="wireguard_mesh_subnet"
                                       help="The IP subnet used for the WireGuard mesh (e.g. 10.100.0.0/24)."/>
                                <field name="wireguard_listen_port"
                                       help="UDP port on which the controller listens for WireGuard connections (default 51820)."/>
                                <field name="controller_endpoint"
                                       help="Public IP:port that worker nodes use to reach this controller."/>
                            </group>
                            <group string="Controller Keys">
                                <field name="wireguard_controller_public_key" nolabel="1"
                                       help="Public key of the controller. Share this with worker nodes."/>
                            </group>
                            <div class="text-muted" colspan="2">
                                <p><b>Security:</b> WireGuard requires Linux kernel ≥ 6.19.14 (or ≥6.18.24)
                                to mitigate CVE-2026-31579. The controller deploy script checks this
                                automatically.</p>
                            </div>
                        </page>

                        <!-- Registered Subnets -->
                        <page string="Registered Subnets">
                            <field name="registered_subnet_ids"
                                   help="Subnets that will be scanned when the 'Scan Network' button is pressed.">
                                <list editable="bottom">
                                    <field name="subnet"/>
                                    <field name="description"/>
                                </list>
                            </field>
                        </page>

                        <!-- GPU Nodes -->
                        <page string="GPU Nodes">
                            <field name="node_ids" context="{'default_cluster_id': id}">
                                <list>
                                    <field name="hostname"/>
                                    <field name="ip_address"/>
                                    <field name="pool"
                                           help="Internal: free, company-wide, multi-GPU. Public: shared with NETTRADES marketplace, earns tokens."/>
                                    <field name="gpu_count"/>
                                    <field name="total_vram_gb" string="VRAM (GB)"/>
                                     <!-- <field name="status" widget="badge"/>  -->
                                    <field name="reputation_score"/>
                                    <field name="token_earnings" widget="monetary"/>
                                    <button name="action_remove_node" string="Remove"
                                            type="object" icon="fa-trash"
                                            confirm="Permanently remove this node? WireGuard peer will be revoked."
                                            help="Removes the node from the cluster and revokes its WireGuard access."/>
                                </list>
                            </field>
                        </page>

                        <!-- Token Economics -->
                        <page string="Token Economics">
                            <group string="Earnings">
                                <field name="total_tokens_served"/>
                                <!--  <field name="total_earnings" widget="monetary"/>  -->
                            </group>
                        </page>

                        <!-- Fine-Tuning (only for trusted clusters) -->
                        <page string="Fine-Tuning"
                              attrs="{'invisible': [('trust_mode', 'not in', ['company_multi_gpu', 'company_single_gpu'])]}">
                            <group string="Training Configuration">
                                <field name="dataset_id" string="Dataset" domain="[('field_id.company_id', '=', company_id)]" help="Select a fine-tuning dataset that was prepared from Good Answer feedback."/>
                                <field name="base_model" string="Base Model" help="Hugging Face model identifier (e.g. deepseek-ai/DeepSeek-R1-Distill-Qwen-14B)."/> 
                                <field name="training_mode" string="Mode" help="Multi-GPU uses Axolotl FSDP2 across the internal WireGuard mesh. Single-GPU uses Unsloth."/> 
                                <field name="gpu_ids" widget="many2many_tags" domain="[('cluster_id', '=', id), ('pool', '=', 'internal')]" help="Select one or more internal-pool GPUs to use for training."/>
                            </group>
                            <button name="action_start_finetune" string="Start Fine-Tuning"
                                    type="object" class="btn-primary"
                                    help="Launch a fine-tuning job on the selected GPUs."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>                
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_gpu_cluster_search" model="ir.ui.view">
        <field name="name">gpu.cluster.search</field>
        <field name="model">gpu.cluster</field>
        <field name="arch" type="xml">
            <search string="Search GPU Clusters">
                <field name="name" string="Cluster Name" help="Search by cluster name."/>
                <field name="trust_mode"/>
                <filter name="active" string="Active" domain="[('active','=',True)]" help="Show only active clusters."/>
                <filter name="inactive" string="Inactive" domain="[('active','=',False)]" help="Show archived clusters."/>
                <separator/>
                <filter name="company" string="Company" domain="[]" context="{'group_by':'company_id'}" help="Group by company."/>
            </search>
        </field>
    </record>
    <menuitem id="menu_gpu_cluster" name="GPU Clusters" parent="menu_gpu_root" sequence="10"/>
    <menuitem id="menu_gpu_cluster_list" name="All Clusters" parent="menu_gpu_cluster" action="action_gpu_cluster"/>
    <menuitem id="menu_gpu_cluster_config" name="Configuration" parent="menu_gpu_cluster" action="action_gpu_cluster_config"/>
</odoo>