<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- =====================================================================
         GPU TOKEN ECONOMICS VIEWS
         ===================================================================== -->
    <record id="view_gpu_economics_tree" model="ir.ui.view">
        <field name="name">gpu.token.economics.tree</field>
        <field name="model">gpu.token.economics</field>
        <field name="arch" type="xml">
            <list string="Token Economics">
                <field name="node_id"/>
                <field name="tokens_earned"/>
                <field name="tokens_spent"/>
                <field name="balance"/>
                <field name="last_transaction"/>
            </list>
        </field>
    </record>

    <record id="view_gpu_economics_form" model="ir.ui.view">
        <field name="name">gpu.token.economics.form</field>
        <field name="model">gpu.token.economics</field>
        <field name="arch" type="xml">
            <form string="Token Economics">
                <sheet>
                    <group>
                        <field name="node_id"/>
                        <field name="tokens_earned"/>
                        <field name="tokens_spent"/>
                        <field name="balance"/>
                        <field name="last_transaction"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>