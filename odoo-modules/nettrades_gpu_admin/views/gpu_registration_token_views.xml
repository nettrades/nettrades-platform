<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Existing view definitions remain -->
    <record id="view_gpu_registration_token_form" model="ir.ui.view">
        <field name="name">gpu.registration.token.form</field>
        <field name="model">gpu.registration.token</field>
        <field name="arch" type="xml">
            <form string="GPU Registration Token">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Token Name"/>
                        </h1>
                    </div>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="cluster_id" required="1"/>
                        <field name="created_by" readonly="1"/>
                    </group>
                    <group string="Token Settings">
                        <field name="node_name" placeholder="Optional: Node name"/>
                        <field name="node_public_key" placeholder="Optional: Node public key"/>
                        <field name="allowed_ips"/>
                    </group>
                    <group string="Lifecycle">
                        <field name="expires_at"/>
                        <field name="is_one_time"/>
                        <field name="is_used"/>
                        <field name="used_at" readonly="1"/>
                        <field name="is_revoked"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_gpu_registration_token_tree" model="ir.ui.view">
        <field name="name">gpu.registration.token.tree</field>
        <field name="model">gpu.registration.token</field>
        <field name="arch" type="xml">
            <list string="GPU Registration Tokens">
                <field name="name"/>
                <field name="cluster_id"/>
                <field name="is_used"/>
                <field name="is_revoked"/>
                <field name="expires_at"/>
                <field name="created_by"/>
            </list>
        </field>
    </record>
</odoo>