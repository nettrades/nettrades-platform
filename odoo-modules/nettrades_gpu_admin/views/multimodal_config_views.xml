<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- =====================================================================
         MULTIMODAL CONFIGURATION VIEWS
         ===================================================================== -->
    <record id="view_multimodal_config_form" model="ir.ui.view">
        <field name="name">multimodal.config.form</field>
        <field name="model">multimodal.config</field>
        <field name="arch" type="xml">
            <form string="Multimodal Configuration">
                <sheet>
                    <group string="Vision Model">
                        <field name="vision_enabled"  help="When enabled, users can upload images in the chat and the AI will analyse them using a Vision-Language Model (VLM)."/>
                        <field name="vision_model_name" attrs="{'invisible': [('vision_enabled','=',False)], 'required': [('vision_enabled','=',True)]}  help="The VLM to use, e.g. 'Qwen2-VL-7B-Instruct'.  This model must already be deployed in GPUStack."/>
                        <field name="vision_model_provider" help="Override the inference endpoint.  Leave blank to use the default GPUStack server." help="Override the inference endpoint.  Leave blank to use the default GPUStack server."/>
                    </group>
                    <div class="text-muted" attrs="{'invisible': [('vision_enabled', '=', False)]}">
                        <p><b>Before enabling:</b></p>
                        <ol>
                            <li>Deploy a VLM (e.g. Qwen2-VL-7B-Instruct) in GPUStack.</li>
                            <li>Ensure the model name matches exactly what is entered above.</li>
                            <li>GPUStack will automatically handle the multimodal projector file.</li>
                        </ol>
                    </div>
                    <group string="Robotics (VLA)">
                        <field name="robotics_enabled"/>
                        <field name="vla_model_name" attrs="{'invisible': [('robotics_enabled','=',False)], 'required': [('robotics_enabled','=',True)]}"/>
                        <field name="ros_master_uri" attrs="{'invisible': [('robotics_enabled','=',False)]}"/>
                    </group>
                    <div class="text-muted" attrs="{'invisible': [('robotics_enabled', '=', False)]}">
                        <p><b>Before enabling:</b></p>
                        <ol>
                            <li>Install the MCP-to-ROS bridge (RoboNeuron) on the robot controller.</li>
                            <li>Deploy a VLA model in GPUStack.</li>
                            <li>Verify network connectivity between the LangGraph container and the ROS 2 master.</li>
                        </ol>
                    </div>
                    <group string="IoT">
                        <field name="iot_enabled"/>
                        <field name="mqtt_broker_url" attrs="{'invisible': [('iot_enabled','=',False)], 'required': [('iot_enabled','=',True)]}"/>
                        <field name="mqtt_topic_prefix"/>
                    </group>
                    <div class="text-muted" attrs="{'invisible': [('iot_enabled', '=', False)]}">
                        <p><b>Before enabling:</b></p>
                        <ol>
                            <li>Deploy an MQTT broker (e.g. <code>docker run -d --name mosquitto eclipse-mosquitto</code>).</li>
                            <li>Ensure the broker is reachable from the LangGraph container.</li>
                        </ol>
                    </div>
                    <group string="Edge Devices">
                        <field name="edge_enabled"/>
                        <field name="default_quantization"/>
                    </group>
                    <div class="text-muted" attrs="{'invisible': [('edge_enabled', '=', False)]}">
                        <p><b>Before enabling:</b></p>
                        <ol>
                            <li>Ensure the target edge device runs the NETTRADES GPU Agent.</li>
                            <li>The agent will automatically detect the device type (Jetson, Raspberry Pi, Coral) and report it to Odoo.</li>
                            <li>No additional configuration is needed on the edge device – the agent handles model deployment.</li>
                        </ol>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_multimodal_config_tree" model="ir.ui.view">
        <field name="name">multimodal.config.tree</field>
        <field name="model">multimodal.config</field>
        <field name="arch" type="xml">
            <tree string="Multimodal Configurations">
                <field name="name"/>
                <field name="vision_enabled" widget="boolean"/>
                <field name="robotics_enabled" widget="boolean"/>
                <field name="iot_enabled" widget="boolean"/>
                <field name="edge_enabled" widget="boolean"/>
            </tree>
        </field>
    </record>

</odoo>