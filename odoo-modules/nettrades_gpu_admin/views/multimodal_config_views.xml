<?xml version="1.0" encoding="utf-8"?>
<!--  FILE: odoo-modules/nettrades_gpu_admin/views/multimodal_config_views.xml  -->
<!--
    NETTRADES GPU Admin — Multi-Modal & Edge Configuration Views
    =============================================================

    UPDATES (2026-09-24):
      - Migrated all attrs="{'invisible': ..., 'required': ...}" expressions
        to Odoo 17+ inline syntax (invisible="...", required="..."). The
        old syntax is deprecated and will be removed in a future version.
      - Removed <field name="name"/> from the tree view: multimodal.config
        inherits res.config.settings (TransientModel) which does not declare
        a `name` field, so the reference would fail at view load time.
      - Changed widget="boolean" to widget="boolean_toggle" in the tree
        view for consistency with the rest of the codebase.
-->
<odoo>
    <!-- =====================================================================
         MULTIMODAL CONFIGURATION VIEWS
         ===================================================================== -->
    <record id="view_multimodal_config_form" model="ir.ui.view">
        <field name="name">multimodal.config.form</field>
        <field name="model">multimodal.config</field>
        <field name="arch" type="xml">
            <form string="Multimodal Configuration">
                <sheet>
                    <group string="Vision Model">
                        <field name="vision_enabled"
                               help="When enabled, users can upload images in the chat and the AI will analyse them using a Vision-Language Model (VLM)."/>
                        <field name="vision_model_name"
                               invisible="not vision_enabled"
                               required="vision_enabled"
                               help="The VLM to use, e.g. 'Qwen2-VL-7B-Instruct'. Must already be deployed."/>
                        <field name="vision_model_provider"
                               help="Override the inference endpoint. Leave blank to use the default server."/>
                    </group>
                    <div class="text-muted" invisible="not vision_enabled">
                        <p><b>Before enabling:</b></p>
                        <ol>
                            <li>Deploy a VLM (e.g. Qwen2-VL-7B-Instruct).</li>
                            <li>Ensure the model name matches exactly what is entered above.</li>
                            <li>The server will automatically handle the multimodal projector file.</li>
                        </ol>
                    </div>

                    <group string="Robotics (VLA)">
                        <field name="robotics_enabled"/>
                        <field name="vla_model_name"
                               invisible="not robotics_enabled"
                               required="robotics_enabled"/>
                        <field name="ros_master_uri"
                               invisible="not robotics_enabled"/>
                    </group>
                    <div class="text-muted" invisible="not robotics_enabled">
                        <p><b>Before enabling:</b></p>
                        <ol>
                            <li>Install the MCP-to-ROS bridge (RoboNeuron) on the robot controller.</li>
                            <li>Deploy a VLA model.</li>
                            <li>Verify network connectivity between the LangGraph container and the ROS 2 master.</li>
                        </ol>
                    </div>

                    <group string="IoT">
                        <field name="iot_enabled"/>
                        <field name="mqtt_broker_url"
                               invisible="not iot_enabled"
                               required="iot_enabled"/>
                        <field name="mqtt_topic_prefix"/>
                    </group>
                    <div class="text-muted" invisible="not iot_enabled">
                        <p><b>Before enabling:</b></p>
                        <ol>
                            <li>Deploy an MQTT broker (e.g. <code>docker run -d --name mosquitto eclipse-mosquitto</code>).</li>
                            <li>Ensure the broker is reachable from the LangGraph container.</li>
                        </ol>
                    </div>

                    <group string="Edge Devices">
                        <field name="edge_enabled"/>
                        <field name="default_quantization"/>
                    </group>
                    <div class="text-muted" invisible="not edge_enabled">
                        <p><b>Before enabling:</b></p>
                        <ol>
                            <li>Ensure the target edge device runs the NETTRADES GPU Agent.</li>
                            <li>The agent will automatically detect the device type (Jetson, Raspberry Pi, Coral) and report it to Odoo.</li>
                            <li>No additional configuration is needed on the edge device - the agent handles model deployment.</li>
                        </ol>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_multimodal_config_tree" model="ir.ui.view">
        <field name="name">multimodal.config.tree</field>
        <field name="model">multimodal.config</field>
        <field name="arch" type="xml">
            <list string="Multimodal Configurations">
                <!-- No `name` field on multimodal.config — it inherits
                     res.config.settings (TransientModel), which does not
                     declare `name`. -->
                <field name="vision_enabled" widget="boolean_toggle"/>
                <field name="robotics_enabled" widget="boolean_toggle"/>
                <field name="iot_enabled" widget="boolean_toggle"/>
                <field name="edge_enabled" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

</odoo>