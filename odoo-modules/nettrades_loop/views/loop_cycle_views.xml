<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Self-improvement loop cycle -->
    <record id="view_loop_cycle_tree" model="ir.ui.view">
        <field name="name">loop.cycle.tree</field>
        <field name="model">loop.cycle</field>
        <field name="arch" type="xml">
            <tree string="Loop Cycles" editable="bottom">
                <field name="name" string="Cycle"/>
                <field name="start_date" string="Started"/>
                <field name="end_date" string="Ended"/>
                <field name="state" string="Status" widget="badge"/>
                <field name="orchestrator_id" string="Orchestrator"/>
            </tree>
        </field>
    </record>

    <record id="view_loop_cycle_form" model="ir.ui.view">
        <field name="name">loop.cycle.form</field>
        <field name="model">loop.cycle</field>
        <field name="arch" type="xml">
            <form string="Loop Cycle">
                <sheet>
                    <group>
                        <field name="name" placeholder="Cycle name..."/>
                        <field name="orchestrator_id" options="{'no_create': True}"/>
                    </group>
                    <group string="Timeline">
                        <field name="start_date" default="(context_today())"/>
                        <field name="end_date"/>
                        <field name="state" widget="statusbar"/>
                    </group>
                    <group string="Outcome">
                        <field name="summary" placeholder="What was achieved?" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_loop_cycle_search" model="ir.ui.view">
        <field name="name">loop.cycle.search</field>
        <field name="model">loop.cycle</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="state"/>
                <field name="orchestrator_id"/>
            </search>
        </field>
    </record>

    <record id="action_loop_cycle" model="ir.actions.act_window">
        <field name="name">Loop Cycles</field>
        <field name="res_model">loop.cycle</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>