<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =====================================================================
         TREE / LIST VIEW
         ===================================================================== -->
    <record id="view_loop_cycle_tree" model="ir.ui.view">
        <field name="name">loop.cycle.tree</field>
        <field name="model">loop.cycle</field>
        <field name="arch" type="xml">
            <list string="Loop Cycles" editable="bottom">
                <field name="name" string="Cycle"/>
                <field name="started_at" string="Started"/>
                <field name="completed_at" string="Ended"/>
                <field name="status" string="Status" widget="badge"/>
                <field name="improvement" string="Improvement (%)"/>
            </list>
        </field>
    </record>

    <!-- =====================================================================
         FORM VIEW
         ===================================================================== -->
    <record id="view_loop_cycle_form" model="ir.ui.view">
        <field name="name">loop.cycle.form</field>
        <field name="model">loop.cycle</field>
        <field name="arch" type="xml">
            <form string="Loop Cycle">
                <header>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Cycle name..."/></h1>
                    </div>
                    <group>
                        <group string="Timeline">
                            <field name="started_at"/>
                            <field name="completed_at"/>
                            <field name="duration_seconds" readonly="1"/>
                        </group>
                        <group string="Results">
                            <field name="improvement"/>
                            <field name="episode_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="What is this cycle for?"/>
                        </page>
                        <page string="Error" invisible="not error_message">
                            <field name="error_message"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- =====================================================================
         SEARCH VIEW
         ===================================================================== -->
    <record id="view_loop_cycle_search" model="ir.ui.view">
        <field name="name">loop.cycle.search</field>
        <field name="model">loop.cycle</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="status"/>
                <filter name="filter_running" string="Running"
                        domain="[('status','=','running')]"/>
                <filter name="filter_completed" string="Completed"
                        domain="[('status','=','completed')]"/>
                <filter name="filter_failed" string="Failed"
                        domain="[('status','=','failed')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_status" string="Status"
                            context="{'group_by':'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- =====================================================================
         ACTION
         ===================================================================== -->
    <record id="action_loop_cycle" model="ir.actions.act_window">
        <field name="name">Loop Cycles</field>
        <field name="res_model">loop.cycle</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No loop cycles yet.
            </p>
            <p>
                Loop cycles are created automatically by the trigger system
                or manually from the Odoo admin interface.
            </p>
        </field>
    </record>

</odoo>