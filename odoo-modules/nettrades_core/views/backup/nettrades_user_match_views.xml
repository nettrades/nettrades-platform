<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nettrades_user_match_tree" model="ir.ui.view">
        <field name="name">nettrades.user_match.tree</field>
        <field name="model">nettrades.user_match</field>
        <field name="arch" type="xml">
            <list string="AI Match Results" editable="bottom">
                <field name="job_id"/>
                <field name="user_id"/>
                <field name="match_score"/>
                <field name="created_at"/>
            </list>
        </field>
    </record>

    <record id="view_nettrades_user_match_form" model="ir.ui.view">
        <field name="name">nettrades.user_match.form</field>
        <field name="model">nettrades.user_match</field>
        <field name="arch" type="xml">
            <form string="AI Match Result">
                <sheet>
                    <group>
                        <field name="job_id" required="1"/>
                        <field name="user_id" required="1"/>
                        <field name="match_score"/>
                        <field name="created_at" readonly="1"/>
                    </group>
                    <group>
                        <field name="analysis"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_nettrades_user_match_search" model="ir.ui.view">
        <field name="name">nettrades.user_match.search</field>
        <field name="model">nettrades.user_match</field>
        <field name="arch" type="xml">
            <search string="Search AI Matches">
                <field name="job_id"/>
                <field name="user_id"/>
                <filter name="high_score" string="High Score" domain="[('match_score','>=',80)]"/>
            </search>
        </field>
    </record>

    <record id="action_nettrades_user_match" model="ir.actions.act_window">
        <field name="name">AI Match Results</field>
        <field name="res_model">nettrades.user_match</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <![CDATA[
                <p class="o_view_nocontent_smiling_face">
                    Review AI-generated matches between jobs and candidates.
                </p>
                <p>
                    These records store the AI match score and analysis used for candidate selection.
                </p>
            ]]>
        </field>
    </record>
</odoo>
