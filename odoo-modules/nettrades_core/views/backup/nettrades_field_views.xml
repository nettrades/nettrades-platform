<?xml version="1.0" encoding="utf-8"?>
<!--
    =============================================================================
    FILE: odoo-modules/nettrades_core/views/nettrades_field_views.xml
    =============================================================================
    PURPOSE:
        Provides views for the nettrades.field model (Professional Fields):
        - Tree/list view showing all fields
        - Form view with all configuration options
        - Search view with filters
    =============================================================================
-->
<odoo>
    <!-- TREE / LIST VIEW -->
    <record id="view_nettrades_field_tree" model="ir.ui.view">
        <field name="name">nettrades.field.tree</field>
        <field name="model">nettrades.field</field>
        <field name="arch" type="xml">
            <list string="Professional Fields" editable="bottom">
                <field name="name"/>
                <field name="description" optional="hide"/>
                <field name="only_qualified" widget="boolean"/>
                <field name="auto_karma_qualify" widget="boolean"/>
                <field name="base_points_per_vote" widget="float"/>
                <field name="qualified_points_per_vote" widget="float"/>
                <field name="finetune_provider"/>
                <field name="enable_data_juicer" widget="boolean"/>
                <field name="enable_deita_scoring" widget="boolean"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_nettrades_field_form" model="ir.ui.view">
        <field name="name">nettrades.field.form</field>
        <field name="model">nettrades.field</field>
        <field name="arch" type="xml">
            <form string="Professional Field">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Field name..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="description" placeholder="Description..."/>
                        </group>
                        <group>
                            <field name="only_qualified"/>
                            <field name="auto_karma_qualify"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- Qualification & Voting -->
                        <page string="Qualification &amp; Voting" name="qualification_voting_page">
                            <group string="Qualification Rules" name="qualification_group">
                                <field name="reputation_threshold_for_charging"/>
                            </group>
                            <group string="Voting Weights" name="voting_group">
                                <field name="base_points_per_vote"/>
                                <field name="qualified_points_per_vote"/>
                                <field name="qualified_professional_count" readonly="1"/>
                                <field name="total_voter_count" readonly="1"/>
                                <field name="suggested_qualified_weight" readonly="1"/>
                                <field name="auto_adjust_weights"/>
                            </group>
                            <group string="Expert Answers" name="expert_group">
                                <field name="expert_answers_trainable"/>
                                <field name="indirect_reputation_points"/>
                            </group>
                            <button name="action_auto_adjust_weights" string="Auto-Adjust Weights Now"
                                    type="object" class="btn-primary" invisible="not auto_adjust_weights"/>
                        </page>

                        <!-- Fine-Tuning -->
                        <page string="Fine-Tuning" name="finetune_page">
                            <group string="Model Configuration" name="model_config_group">
                                <field name="finetune_provider"/>
                                <field name="base_model"/>
                                <field name="hyperparameters" widget="json"/>
                            </group>
                            <group string="Training Parameters" name="training_group">
                                <field name="min_votes_for_training"/>
                                <field name="min_unique_voters"/>
                            </group>
                            <group string="Advanced Training" name="advanced_training_group">
                                <field name="enable_grpo_training"/>
                                <field name="enable_benchmark_evaluation"/>
                                <field name="enable_ab_testing"/>
                                <field name="ab_testing_traffic_split" invisible="not enable_ab_testing"/>
                                <field name="auto_promote_threshold" invisible="not enable_ab_testing"/>
                            </group>
                        </page>

                        <!-- Data-Juicer -->
                        <page string="Data-Juicer" name="data_juicer_page">
                            <group string="Quality Pipeline Configuration" name="quality_group">
                                <field name="enable_data_juicer"/>
                                <field name="data_juicer_status" widget="badge"
                                       invisible="not enable_data_juicer"/>
                            </group>
                            <group string="Endpoint &amp; Thresholds"
                                   invisible="not enable_data_juicer"
                                   name="endpoint_thresholds_group">
                                <field name="data_juicer_endpoint_type"/>
                                <field name="data_juicer_min_quality_score"/>
                                <field name="data_juicer_max_rejection_rate"/>
                            </group>
                            <group string="Additional Filters"
                                   invisible="not enable_data_juicer"
                                   name="additional_filters_group">
                                <field name="data_juicer_enable_dedup"/>
                                <field name="data_juicer_enable_pii"/>
                            </group>
                            <div class="text-muted" invisible="enable_data_juicer">
                                Enable Data-Juicer to configure quality filtering.
                            </div>
                            <div class="text-muted" invisible="not enable_data_juicer">
                                <p><strong>How Data-Juicer works:</strong> When a fine-tuning dataset is exported for this field, Data-Juicer runs the `llm_quality_score_filter` operator using the selected inference endpoint. Each (question, answer) pair is scored for quality. Pairs scoring below the minimum threshold are rejected. If more than the Maximum Rejection Rate of samples are rejected, Data-Juicer is automatically disabled to prevent starving the training pipeline.</p>
                                <p><strong>Auto-disable safety net:</strong> If you enable Auto-Disable on Poor Results and the rejection rate exceeds the threshold, Data-Juicer is automatically disabled and an Odoo activity is created for the administrator. This prevents a misconfigured threshold from blocking all fine-tuning.</p>
                                <p><strong>Dependencies:</strong> Data-Juicer must be installed in the Python environment (`pip install 'py-data-juicer[generic,nlp]'`). If it is not available, the quality pipeline will be skipped and the unfiltered dataset will be used.</p>
                            </div>
                        </page>

                        <!-- DEITA Scoring -->
                        <page string="DEITA Scoring" name="deita_page">
                            <group string="DEITA Configuration" name="deita_group">
                                <field name="enable_deita_scoring"/>
                                <field name="deita_min_complexity"
                                       invisible="not enable_deita_scoring"/>
                                <field name="deita_judge_model"
                                       invisible="not enable_deita_scoring"/>
                            </group>
                            <div class="text-muted" invisible="enable_deita_scoring">
                                Enable DEITA scoring to use LLM-as-Judge for dataset quality evaluation.
                            </div>
                            <div class="text-muted" invisible="not enable_deita_scoring">
                                <p><strong>How LLM-as-Judge works:</strong> After Data-Juicer filtering (if enabled), each surviving (question, answer) pair is scored by an LLM judge on complexity and quality. Pairs that fail to meet the minimum thresholds are rejected before training.</p>
                                <p><strong>DEITA research backing:</strong> "DEITA introduces a way to measure data quality across three critical dimensions: complexity, quality and diversity." Models fine-tuned on a small amount of carefully selected high-quality data outperform models trained on 10× the data selected randomly.</p>
                                <p><strong>Dependencies:</strong> `distilabel[vllm]` must be installed. If missing, the DEITA step will be skipped silently.</p>
                            </div>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="view_nettrades_field_search" model="ir.ui.view">
        <field name="name">nettrades.field.search</field>
        <field name="model">nettrades.field</field>
        <field name="arch" type="xml">
            <search string="Search Fields">
                <field name="name"/>
                <field name="description"/>
                <filter name="only_qualified" string="Manual Verification Required"
                        domain="[('only_qualified','=',True)]"/>
                <filter name="auto_karma" string="Auto-Qualify by Karma"
                        domain="[('auto_karma_qualify','=',True)]"/>
                <filter name="data_juicer_enabled" string="Data-Juicer Enabled"
                        domain="[('enable_data_juicer','=',True)]"/>
                <filter name="deita_enabled" string="DEITA Scoring Enabled"
                        domain="[('enable_deita_scoring','=',True)]"/>
                <separator/>
                <filter name="group_by_provider" string="Backend" domain="[]"
                        context="{'group_by':'finetune_provider'}"/>
            </search>
        </field>
    </record>

    <!-- ACTIONS -->
    <record id="action_nettrades_field" model="ir.actions.act_window">
        <field name="name">Professional Fields</field>
        <field name="res_model">nettrades.field</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <![CDATA[
                <p class="o_view_nocontent_smiling_face">
                    Create a new professional field
                </p>
                <p>
                    Professional fields define domains of expertise (e.g., Cardiology,
                    Python Development, Legal Advisory). They control qualification,
                    voting weights, and fine-tuning for AI models.
                </p>
            ]]>
        </field>
    </record>

    <record id="action_nettrades_skill" model="ir.actions.act_window">
        <field name="name">Skills</field>
        <field name="res_model">nettrades.skill</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>