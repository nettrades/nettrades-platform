<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ======================================================================
    NETTRADES User Views
    ======================================================================= -->
    <!--
        This file defines the views for the nettrades.user model.
        It includes:
          - List view (formerly tree view)
          - Form view
          - Action
          - Menu item (under the NETTRADES root menu)
    -->

    <!-- List View -->
    <record id="view_nettrades_user_list" model="ir.ui.view">
        <field name="name">nettrades.user.list</field>
        <field name="model">nettrades.user</field>
        <field name="arch" type="xml">
            <list string="NetTrades Users" editable="bottom">
                <field name="partner_id"/>
                <field name="username"/>
                <field name="karma_score"/>
                <field name="reputation_score"/>
                <field name="is_verified"/>
                <field name="is_online"/>
                <field name="is_active"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_nettrades_user_form" model="ir.ui.view">
        <field name="name">nettrades.user.form</field>
        <field name="model">nettrades.user</field>
        <field name="arch" type="xml">
            <form string="NetTrades User">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="partner_id" widget="many2one"/>
                        </h1>
                    </div>
                    <group>
                        <group string="User Details">
                            <field name="username"/>
                            <field name="wallet_address"/>
                            <field name="is_verified"/>
                            <field name="is_online"/>
                            <field name="is_active"/>
                        </group>
                        <group string="Reputation">
                            <field name="karma_score"/>
                            <field name="reputation_score"/>
                        </group>
                    </group>
                    <group string="Expert Information">
                        <field name="is_expert"/>
                        <field name="expert_rate" invisible="not is_expert"/>
                        <field name="expert_bio" invisible="not is_expert"/>
                    </group>
                    <group string="Worker Agent">
                        <field name="worker_agent"/>
                        <field name="worker_context"/>
                        <field name="worker_started"/>
                    </group>
                    <group string="Audit">
                        <field name="create_date"/>
                        <field name="write_date"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_nettrades_users" model="ir.actions.act_window">
        <field name="name">NetTrades Users</field>
        <field name="res_model">nettrades.user</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Manage NetTrades users and their reputation.
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_nettrades_users"
              name="Users"
              parent="nettrades_core.menu_nettrades_root"
              action="action_nettrades_users"
              sequence="10"/>
</odoo>