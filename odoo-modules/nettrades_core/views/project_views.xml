<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_form_inherit" model="ir.ui.view">
        <field name="name">project.project.form.inherit</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <field name="company_id" position="after">
                <field name="forgejo_repo_url" placeholder="Forgejo repository URL..."
                       help="URL of the Forgejo repository for this project."/>
                <field name="budget" placeholder="Project budget..."
                       help="Budget for this project (for freelance projects)."/>
            </field>
            <xpath expr="//field[@name='name']" position="after">
                <button name="action_create_forgejo_repo"
                        string="Create Forgejo Repository"
                        type="object"
                        class="btn-primary"
                        help="Create a Forgejo repository for this project."/>
                <button name="action_leave_review"
                        string="Leave Review"
                        type="object"
                        class="btn-secondary"
                        help="Open the review form for the assigned project user."/>
            </xpath>
        </field>
    </record>
</odoo>