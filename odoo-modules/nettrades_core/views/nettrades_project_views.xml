<?xml version="1.0" encoding="utf-8"?>
<!--
    NETTRADES Project Views
    Defines the tree, form, and search views for the nettrades.project model.
-->
<odoo>
    <data>

        <!-- Tree View -->
        <record id="view_nettrades_project_tree" model="ir.ui.view">
            <field name="name">nettrades.project.tree</field>
            <field name="model">nettrades.project</field>
            <field name="arch" type="xml">
                <tree string="Projects">
                    <field name="title"/>
                    <field name="company_id"/>
                    <field name="budget"/>
                    <field name="status"/>
                    <field name="created_at"/>
                </tree>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_nettrades_project_form" model="ir.ui.view">
            <field name="name">nettrades.project.form</field>
            <field name="model">nettrades.project</field>
            <field name="arch" type="xml">
                <form string="Project">
                    <sheet>
                        <group>
                            <field name="title"/>
                            <field name="company_id"/>
                            <field name="budget"/>
                            <field name="status"/>
                        </group>
                        <group>
                            <field name="description"/>
                            <field name="required_skills"/>
                        </group>
                        <group>
                            <field name="created_at"/>
                            <field name="updated_at"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_nettrades_project_search" model="ir.ui.view">
            <field name="name">nettrades.project.search</field>
            <field name="model">nettrades.project</field>
            <field name="arch" type="xml">
                <search string="Search Projects">
                    <field name="title"/>
                    <field name="company_id"/>
                    <filter string="Open" name="open" domain="[('status','=','open')]"/>
                    <filter string="Closed" name="closed" domain="[('status','=','closed')]"/>
                    <separator/>
                    <filter string="High Budget" name="high_budget" domain="[('budget','>',10000)]"/>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="action_nettrades_project" model="ir.actions.act_window">
            <field name="name">Projects</field>
            <field name="res_model">nettrades.project</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first project!
                </p>
            </field>
        </record>

        <!-- Menu Item -->
        <menuitem id="menu_nettrades_project" 
                  name="Projects" 
                  parent="menu_nettrades_core" 
                  action="action_nettrades_project"
                  sequence="10"/>

    </data>
</odoo>