<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nettrades_experience_tree" model="ir.ui.view">
        <field name="name">nettrades.experience.tree</field>
        <field name="model">nettrades.experience</field>
        <field name="arch" type="xml">
            <tree string="Experience" editable="bottom">
                <field name="partner_id"/>
                <field name="job_title"/>
                <field name="company"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="is_current"/>
            </tree>
        </field>
    </record>

    <record id="view_nettrades_experience_form" model="ir.ui.view">
        <field name="name">nettrades.experience.form</field>
        <field name="model">nettrades.experience</field>
        <field name="arch" type="xml">
            <form string="Experience">
                <sheet>
                    <group>
                        <field name="partner_id" required="1"/>
                        <field name="job_title" required="1"/>
                        <field name="company" required="1"/>
                    </group>
                    <group>
                        <field name="start_date" required="1"/>
                        <field name="end_date"/>
                        <field name="is_current" readonly="1"/>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_nettrades_experience_search" model="ir.ui.view">
        <field name="name">nettrades.experience.search</field>
        <field name="model">nettrades.experience</field>
        <field name="arch" type="xml">
            <search string="Search Experience">
                <field name="partner_id"/>
                <field name="job_title"/>
                <field name="company"/>
                <filter name="current_positions" string="Current" domain="[('is_current','=',True)]"/>
            </search>
        </field>
    </record>

    <record id="action_nettrades_experience" model="ir.actions.act_window">
        <field name="name">Experience</field>
        <field name="res_model">nettrades.experience</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <![CDATA[
                <p class="o_view_nocontent_smiling_face">
                    Create work experience entries for partners.
                </p>
                <p>
                    Experience entries are used to document the career history of freelancers and job seekers.
                </p>
            ]]>
        </field>
    </record>
</odoo>
