<!-- Add onboarding fields to partner form -->
<odoo>
    <record id="view_partner_form_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Professional" name="professional">
                    <group>
                        <field name="user_type"/>
                        <field name="professional_summary"/>
                        <field name="skill_ids" widget="many2many_tags"/>
                        <field name="hourly_rate" invisible="user_type != 'freelancer'"/>
                        <field name="forgejo_username"/>
                        <field name="github_username"/>
                        <field name="blog_url" widget="url"/>
                        <field name="resume_pdf" filename="resume_pdf"/>
                    </group>
                    <group string="Work Experience">
                        <field name="experience_ids">
                            <list editable="bottom">
                                <field name="job_title"/>
                                <field name="company"/>
                                <field name="start_date"/>
                                <field name="end_date"/>
                                <field name="description"/>
                            </list>
                        </field>
                    </group>
                    <group string="Reviews">
                        <field name="average_rating" widget="statinfo"/>
                        <!-- We'll use a separate reviews page or list -->
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>