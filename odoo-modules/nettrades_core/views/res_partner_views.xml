<?xml version="1.0" encoding="utf-8"?>
<!-- =============================================================================
     FILE: odoo-modules/nettrades_core/views/res_partner_views.xml
     =============================================================================
     PURPOSE:
       Extends the res.partner form view with NETTRADES-specific fields for:
       - Professional profiles (summary, hourly rate, resume)
       - Social media / contact fields (Forgejo, GitHub, LinkedIn, Twitter, Blog)
       - Duplicate detection (VAT, Company Registry)
       - Average rating display
     ============================================================================= -->
<odoo>
    <record id="view_partner_form_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!-- =====================================================================
                 SECTION 1: Professional Profile Fields
                 ===================================================================== -->
            <field name="email" position="after">
                <field name="user_type" placeholder="Select user type..."/>
            </field>

            <field name="phone" position="after">
                <field name="professional_summary" placeholder="Professional summary..."/>
                <field name="hourly_rate" attrs="{'invisible': [('user_type', '!=', 'freelancer')]}"/>
                <field name="resume_pdf" filename="resume_filename"/>
            </field>

            <!-- =====================================================================
                 SECTION 2: Social / Contact Fields
                 ===================================================================== -->
            <field name="website" position="after">
                <group string="Social Media / Platforms" name="social_media_group">
                    <field name="forgejo_username" placeholder="Forgejo username"/>
                    <field name="github_username" placeholder="GitHub username"/>
                    <field name="linkedin_username" placeholder="LinkedIn username"/>
                    <field name="twitter_username" placeholder="Twitter/X username"/>
                    <field name="blog_url" placeholder="Blog URL"/>
                </group>
            </field>

            <!-- =====================================================================
                 SECTION 3: Duplicate Detection (VAT & Company Registry)
                 ===================================================================== -->
            <field name="vat" position="after">
                <field name="company_registry" placeholder="Company registry number"/>
            </field>

            <!-- Duplicate detection warning block -->
            <field name="company_registry" position="after">
                <div class="alert alert-warning oe_edit_only" role="alert"
                     name="warning_duplicates"
                     invisible="not same_vat_partner_id and not same_company_registry_partner_id">
                    <span>Potential duplicates found:</span>
                    <span invisible="not same_vat_partner_id or same_company_registry_partner_id">
                        <field name="same_vat_partner_id" context="{'show_address': False, 'show_vat': False}"/>
                        (Same <field name="vat_label"/>)
                    </span>
                    <span invisible="same_vat_partner_id or not same_company_registry_partner_id">
                        <field name="same_company_registry_partner_id" context="{'show_address': False, 'show_vat': False}"/>
                        (Same Company Registry)
                    </span>
                    <span invisible="not (same_vat_partner_id and same_company_registry_partner_id)">
                        <field name="same_vat_partner_id" context="{'show_address': False, 'show_vat': False}"/>
                        (Same <field name="vat_label"/> and Company Registry)
                    </span>
                </div>
            </field>

            <!-- =====================================================================
                 SECTION 4: Average Rating Display
                 ===================================================================== -->
            <field name="company_registry" position="after">
                <field name="average_rating" widget="star" invisible="average_rating == 0"/>
            </field>

            <!-- =====================================================================
                 SECTION 5: Karma and Reputation (if not already displayed)
                 ===================================================================== -->
            <field name="company_registry" position="after">
                <group string="NETTRADES Reputation" name="reputation_group">
                    <field name="karma" readonly="1"/>
                    <field name="reputation_score" readonly="1"/>
                </group>
            </field>

            <!-- =====================================================================
                 SECTION 6: Worker Agent (if autonomous administration is enabled)
                 ===================================================================== -->
            <xpath expr="//notebook" position="inside">
                <page string="Worker Agent" name="worker_agent_page">
                    <group string="Autonomous Worker Agent" name="worker_agent_group">
                        <field name="worker_agent" placeholder="Agent ID..."/>
                        <field name="worker_started" widget="boolean"/>
                        <div class="text-muted" invisible="worker_agent">
                            <span>No worker agent configured.</span>
                        </div>
                        <button name="action_start_worker_agent" string="Start Worker" type="object"
                                class="btn-primary" invisible="worker_started or not worker_agent"/>
                        <button name="action_stop_worker_agent" string="Stop Worker" type="object"
                                class="btn-danger" visible="worker_started"/>
                    </group>
                    <group string="Worker Context (JSON)" name="worker_context_group">
                        <field name="worker_context" widget="json"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>