<?xml version="1.0" encoding="utf-8"?>
<!--
    =============================================================================
    FILE: odoo-modules/nettrades_core/views/nettrades_core_menu.xml
    =============================================================================
    PURPOSE:
        Defines the sub-menu items that reference ACTIONS from the view files.
        This file MUST load AFTER all view files.

    WHY THIS FILE IS NOT THE ROOT MENU:
        The root menu item (menu_nettrades_root) is defined in
        nettrades_core_menu_root.xml and loaded FIRST, because the view
        files reference it as a parent.

        This file references actions defined in nettrades_field_views.xml
        and other view files, so it must load AFTER them.

    FIXED (2026-09-16):
        - The root menu item was moved to nettrades_core_menu_root.xml.
        - The parent reference now points to `menu_nettrades_root` (matching
          the ID defined in the new root file).
    =============================================================================
-->
<odoo>
    <!-- Configuration parent (admin only).
         This has no action reference, so it can live in either file.
         It sits here because it groups the admin sub-menus below. -->
    <menuitem id="menu_nettrades_config_root"
              name="Configuration"
              parent="menu_nettrades_root"
              sequence="90"
              groups="base.group_system"/>

    <!-- Professional Fields -->
    <menuitem id="menu_nettrades_fields_root"
              name="Professional Fields"
              parent="menu_nettrades_config_root"
              sequence="10"/>

    <menuitem id="menu_nettrades_fields_list"
              name="Fields"
              parent="menu_nettrades_fields_root"
              action="action_nettrades_field"/>

    <!-- Skills -->
    <menuitem id="menu_nettrades_skills_root"
              name="Skills"
              parent="menu_nettrades_config_root"
              sequence="20"/>

    <menuitem id="menu_nettrades_skills_list"
              name="Skills"
              parent="menu_nettrades_skills_root"
              action="action_nettrades_skill"/>
</odoo>