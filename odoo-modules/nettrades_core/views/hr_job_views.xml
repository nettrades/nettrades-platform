<?xml version="1.0" encoding="utf-8"?>
<!--
    =============================================================================
    FILE: odoo-modules/nettrades_core/views/hr_job_views.xml
    =============================================================================
    PURPOSE:
        Extends the hr.job form view with NETTRADES AI matching fields.
    =============================================================================
-->
<odoo>
    <record id="view_hr_job_form_inherit" model="ir.ui.view">
        <field name="name">hr.job.form.inherit</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr.view_hr_job_form"/>
        <field name="arch" type="xml">
            <!-- AI Match Candidates Button -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_match_candidates" string="AI Match Candidates" type="object" class="btn-primary" help="Use AI to match candidates for this job position."/>
                <button name="action_match_candidates_async" string="Match Candidates in Background" type="object" class="btn-secondary" help="Queue AI candidate matching as a background job."/>
            </xpath>
            <!-- AI Matching Configuration -->
            <xpath expr="//sheet" position="inside">
                <group string="AI Matching Configuration" name="ai_matching_group">
                    <field name="required_skills" placeholder="Skills required for this job..."/>
                    <field name="min_years_experience" placeholder="Minimum years of experience"/>
                    <field name="is_freelance_project" widget="boolean"/>
                    <field name="budget" invisible="not is_freelance_project"
                           placeholder="Project budget"/>
                    <field name="forgejo_repo_url" placeholder="Forgejo repository URL"
                           readonly="1" help="URL of the Forgejo repository for this job/project."/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>