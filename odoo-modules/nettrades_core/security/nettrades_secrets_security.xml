<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Secrets Manager group -->
        <record id="group_secrets_manager" model="res.groups">
            <field name="name">Secrets Manager</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="implied_ids" eval="[(4, ref('base.group_system'))]"/>
        </record>
        
        <!-- Only Secrets Managers can read secrets -->
        <record id="secrets_read_rule" model="ir.rule">
            <field name="name">Secrets: Read</field>
            <field name="model_id" ref="model_nettrades_secrets"/>
            <field name="domain_force">[
                ('visible_to', 'in', ('all', 'secrets_manager')),
                ('visible_to', '=', 'secrets_manager') if user.has_group('nettrades_core.group_secrets_manager') else []
            ]</field>
            <field name="groups" eval="[(4, ref('nettrades_core.group_secrets_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        
        <!-- Only Secrets Managers can write secrets -->
        <record id="secrets_write_rule" model="ir.rule">
            <field name="name">Secrets: Write</field>
            <field name="model_id" ref="model_nettrades_secrets"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('nettrades_core.group_secrets_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
        
        <!-- Regular users cannot see secrets at all -->
        <record id="secrets_regular_user_rule" model="ir.rule">
            <field name="name">Secrets: No Access for Regular Users</field>
            <field name="model_id" ref="model_nettrades_secrets"/>
            <field name="domain_force">[(1, '=', 0)]</field>
            <field name="groups" eval="[(4, ref('nettrades_core.group_regular_user'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>