<!--
    ============================================================================
    NETTRADES Core - Security Groups & Record Rules
    ============================================================================
    FILE:    odoo-modules/nettrades_core/security/nettrades_security.xml
    VERSION: 2.2

    PURPOSE:
        Defines the user groups and record rules used across the NETTRADES platform.
        These enforce tenant isolation and access control.

    GROUPS:
        1. NETTRADES Manager - full access to all NETTRADES features.
        2. NETTRADES User - standard user access (portal, jobs, profiles).
        3. NETTRADES API - for external API integrations.

    RECORD RULES:
        Tenant isolation rules that prevent cross-company data access.
        Users can only see records belonging to their own company.

    UPDATES (2026-08):
        - Added complete tenant isolation record rules for all models
        - Fixed model references to match actual model names
        - Added admin override rule for system administrators

    UPDATES (2026-09-15):
        - Every original rule is preserved with its original id.
        - Rules whose model is not defined in nettrades_core have been
          COMMENTED OUT (not deleted). Each commented block has a
          `TODO(move)` marker explaining where the rule should go once
          the model is moved to its own module in the final phase.
        - A rule whose model does not exist in this module causes the
          module to abort with:
              ValueError: External ID not found in the system: <ref>
          so any active rule MUST reference a model that is actually
          imported by nettrades_core/models/__init__.py.
        - The admin override rule was renamed back to its ORIGINAL id
          `rule_company_admin_all`.

    UPDATES (2026-09-16):
        - FIXED: rule_company_experiences referenced 'user_id.company_id',
          but nettrades.experience has no 'user_id' field. The correct
          field (per grep of fields.Many2one in the model) is
          'partner_id'. The domain was updated to 'partner_id.company_id'.
          The error was:
              Invalid domain: Invalid field nettrades.experience.user_id
              in condition ('user_id.company_id', '=', 1)
        - Cross-checked every other active rule's domain against the
          actual fields declared by grep in the model files. All others
          resolve correctly (verified 2026-09-16).
    ============================================================================
-->
<odoo>

    <!-- =========================================================================
         USER GROUPS
         ========================================================================= -->

    <!-- 1. NETTRADES Manager - highest privilege level -->
    <record id="group_nettrades_manager" model="res.groups">
        <field name="name">NETTRADES Manager</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <!--<field name="comment">Full access to all NETTRADES platform features.</field>-->
    </record>

    <!-- 2. NETTRADES User - standard user -->
    <record id="group_nettrades_user" model="res.groups">
        <field name="name">NETTRADES User</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <!--<field name="comment">Standard user access for the NETTRADES platform.</field>-->
    </record>

    <!-- 3. NETTRADES API - for API calls -->
    <record id="group_nettrades_api" model="res.groups">
        <field name="name">NETTRADES API</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <!--<field name="comment">API access group for external integrations.</field>-->
    </record>

    <!-- 4. Secrets Manager - can read/write encrypted secrets -->
    <record id="group_secrets_manager" model="res.groups">
        <field name="name">NETTRADES Secrets Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_nettrades_manager'))]"/>
    </record>

    <!-- =========================================================================
         TENANT ISOLATION RECORD RULES - ACTIVE
         Every rule below references a model that IS defined in nettrades_core.
         Every domain has been verified against the model's actual fields.
         ========================================================================= -->

    <!-- nettrades_user: Users belong to a company -->
    <record id="rule_company_user" model="ir.rule">
        <field name="name">Tenant: Users - Own Company Only</field>
        <field name="model_id" ref="nettrades_core.model_nettrades_user"/>
        <field name="domain_force">[('company_id','=',user.company_id.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
        <!--<field name="comment">Users can only see and modify users from their own company.</field>-->
    </record>

    <!-- nettrades_companies: Companies are tenants -->
    <record id="rule_company_companies" model="ir.rule">
        <field name="name">Tenant: Companies - Own Company Only</field>
        <field name="model_id" ref="nettrades_core.model_nettrades_company"/>
        <field name="domain_force">[('id','=',user.company_id.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <!--<field name="comment">Users can only see their own company record.</field>-->
    </record>

    <!-- nettrades_projects: Projects belong to a company -->
    <record id="rule_company_projects" model="ir.rule">
        <field name="name">Tenant: Projects - Own Company Only</field>
