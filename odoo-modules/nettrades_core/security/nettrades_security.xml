        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
        <!--<field name="comment">Users can only access votes from their own company.</field>-->
    </record>

    <!-- nettrades_experience: Experiences belong to a company via partner.
         The model only has a 'partner_id' field (no 'user_id'), so the
         domain traverses 'partner_id.company_id', not 'user_id.company_id'.
         FIXED 2026-09-16. -->
