        <field name="perm_unlink" eval="False"/>
        <!--<field name="comment">Users can only access projects from their own company.</field>-->
    </record>

    <!-- nettrades_good_answers: Good Answers belong to a company via user -->
    <record id="rule_company_good_answers" model="ir.rule">
        <field name="name">Tenant: Good Answers - Own Company Only</field>
        <field name="model_id" ref="nettrades_core.model_nettrades_good_answer"/>
        <field name="domain_force">[('user_id.company_id','=',user.company_id.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
        <!--<field name="comment">Users can only access good answers from their own company.</field>-->
    </record>

    <!-- nettrades_votes: Votes belong to a company via answer -->
    <record id="rule_company_votes" model="ir.rule">
        <field name="name">Tenant: Votes - Own Company Only</field>
        <field name="model_id" ref="nettrades_core.model_nettrades_vote"/>
        <field name="domain_force">[('answer_id.user_id.company_id','=',user.company_id.id)]</field>
