<?xml version="1.0" encoding="utf-8"?>
<!--
    ============================================================================
    NETTRADES Core – Security Groups & Record Rules
    ============================================================================
    FILE:    odoo-modules/nettrades_core/security/nettrades_security.xml
    VERSION: 2.1

    PURPOSE:
        Defines the user groups and record rules used across the NETTRADES platform.
        These enforce tenant isolation and access control.

    GROUPS:
        1. NETTRADES Manager – full access to all NETTRADES features.
        2. NETTRADES User – standard user access (portal, jobs, profiles).
        3. NETTRADES API – for external API integrations.

    RECORD RULES:
        Tenant isolation rules that prevent cross-company data access.
        Users can only see records belonging to their own company.

    UPDATES (2026-09):
        - FIXED: All domain rules now use user.company_id.id (which exists on nettrades.user)
        - FIXED: company_id is now a related field on nettrades.user (store=True)
        - FIXED: Proper XML structure with all tags
        - Added comments for each rule explaining the isolation logic
    ============================================================================
-->
<odoo>

    <!-- =========================================================================
         USER GROUPS
         ========================================================================= -->

    <!-- 1. NETTRADES Manager – highest privilege level -->
    <record id="group_nettrades_manager" model="res.groups">
        <field name="name">NETTRADES Manager</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Full access to all NETTRADES platform features.</field>
    </record>

    <!-- 2. NETTRADES User – standard user -->
    <record id="group_nettrades_user" model="res.groups">
        <field name="name">NETTRADES User</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Standard user access for the NETTRADES platform.</field>
    </record>

    <!-- 3. NETTRADES API – for API calls -->
    <record id="group_nettrades_api" model="res.groups">
        <field name="name">NETTRADES API</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">API access group for external integrations.</field>
    </record>

    <!-- 4. NETTRADES Secrets Manager – for credential management -->
    <record id="group_secrets_manager" model="res.groups">
        <field name="name">NETTRADES Secrets Manager</field>
        <field name="implied_ids" eval="[(4, ref('base.group_system'))]"/>
        <field name="comment">Can manage encrypted secrets and credentials.</field>
    </record>

    <!-- 5. NETTRADES GPU Admin – for GPU node management -->
    <record id="group_gpu_admin" model="res.groups">
        <field name="name">NETTRADES GPU Admin</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can manage GPU nodes and marketplace listings.</field>
    </record>

    <!-- =========================================================================
         TENANT ISOLATION RECORD RULES
         These rules enforce that users can only access records belonging
         to their own company (tenant). This is the primary mechanism for
         preventing cross-tenant data leakage.

         FIXED: All rules now use user.company_id.id which exists on nettrades.user
                as a related field (store=True) from partner_id.company_id.
         ========================================================================= -->

    <!-- nettrades_users: Users belong to a company -->
    <record id="rule_company_user" model="ir.rule">
        <field name="name">Tenant: Users - Own Company Only</field>
        <field name="model_id" ref="nettrades_core.model_nettrades_user"/>
        <field name="domain_force">[('company_id','=',user.company_id.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
        <field name="comment">Users can only see and modify users from their own company.</field>
    </record>

    <!-- nettrades_companies: Companies are tenants -->
    <record id="rule_company_companies" model="ir.rule">
        <field name="name">Tenant: Companies - Own Company Only</field>
        <field name="model_id" ref="nettrades_core.model_nettrades_company"/>
        <field name="domain_force">[('id','=',user.company_id.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="comment">Users can only see their own company record.</field>
    </record>

