<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_data_edge_case_tree" model="ir.ui.view">
        <field name="name">data.edge_case.tree</field>
        <field name="model">data.edge_case</field>
        <field name="arch" type="xml">
            <list string="Edge Cases">
                <field name="detection_type"/>
                <field name="episode_id"/>
                <field name="similarity_score"/>
                <field name="is_confirmed" widget="boolean_toggle"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="view_data_edge_case_form" model="ir.ui.view">
        <field name="name">data.edge_case.form</field>
        <field name="model">data.edge_case</field>
        <field name="arch" type="xml">
            <form string="Edge Case">
                <sheet>
                    <group>
                        <field name="episode_id"/>
                        <field name="detection_type"/>
                        <field name="similarity_score"/>
                        <field name="is_confirmed"/>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_data_edge_case_search" model="ir.ui.view">
        <field name="name">data.edge_case.search</field>
        <field name="model">data.edge_case</field>
        <field name="arch" type="xml">
            <search>
                <field name="episode_id"/>
                <field name="detection_type"/>
                <filter name="confirmed" string="Confirmed" domain="[('is_confirmed','=',True)]"/>
                <filter name="novel" string="Novel Pattern" domain="[('detection_type','=','novel_pattern')]"/>
            </search>
        </field>
    </record>

    <record id="action_data_edge_case" model="ir.actions.act_window">
        <field name="name">Edge Cases</field>
        <field name="res_model">data.edge_case</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>