<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_data_annotation_tree" model="ir.ui.view">
        <field name="name">data.annotation.tree</field>
        <field name="model">data.annotation</field>
        <field name="arch" type="xml">
            <list string="Annotations">
                <field name="annotation_type"/>
                <field name="episode_id"/>
                <field name="annotator_id"/>
                <field name="quality_score"/>
                <field name="is_approved" widget="boolean_toggle"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="view_data_annotation_form" model="ir.ui.view">
        <field name="name">data.annotation.form</field>
        <field name="model">data.annotation</field>
        <field name="arch" type="xml">
            <form string="Annotation">
                <sheet>
                    <group>
                        <field name="annotation_type"/>
                        <field name="episode_id" options="{'no_create': True}"/>
                        <field name="annotator_id"/>
                    </group>
                    <group string="Signals">
                        <field name="quality_score"/>
                        <field name="is_approved"/>
                    </group>
                    <group string="Data">
                        <field name="annotation_data" widget="json"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_data_annotation_search" model="ir.ui.view">
        <field name="name">data.annotation.search</field>
        <field name="model">data.annotation</field>
        <field name="arch" type="xml">
            <search>
                <field name="annotation_type"/>
                <field name="annotator_id"/>
                <field name="episode_id"/>
                <filter name="approved" string="Approved" domain="[('is_approved','=',True)]"/>
                <filter name="pending" string="Pending" domain="[('is_approved','=',False)]"/>
                <filter name="my_annotations" string="Mine" domain="[('annotator_id','=',uid)]"/>
            </search>
        </field>
    </record>

    <record id="action_data_annotation" model="ir.actions.act_window">
        <field name="name">Annotations</field>
        <field name="res_model">data.annotation</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>