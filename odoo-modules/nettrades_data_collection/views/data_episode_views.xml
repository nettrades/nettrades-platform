<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_data_episode_tree" model="ir.ui.view">
        <field name="name">data.episode.tree</field>
        <field name="model">data.episode</field>
        <field name="arch" type="xml">
            <list string="Episodes">
                <field name="name" string="Episode Name"/>
                <field name="source" widget="badge"/>
                <field name="field_id"/>
                <field name="partner_id"/>
                <field name="quality_score" widget="float"/>
                <field name="vote_count"/>
                <field name="is_qualified" widget="boolean_toggle"/>
                <field name="processed" widget="boolean_toggle"/>
                <field name="create_date" string="Created On"/>
            </list>
        </field>
    </record>

    <record id="view_data_episode_form" model="ir.ui.view">
        <field name="name">data.episode.form</field>
        <field name="model">data.episode</field>
        <field name="arch" type="xml">
            <form string="Episode">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Episode name..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="source"/>
                            <field name="source_id"/>
                            <field name="field_id"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="quality_score"/>
                            <field name="confidence_score"/>
                            <field name="vote_count"/>
                            <field name="is_qualified"/>
                            <field name="processed"/>
                            <field name="processed_date" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Input" name="input">
                            <field name="input_text" nolabel="1"/>
                        </page>
                        <page string="Output" name="output">
                            <field name="output_text" nolabel="1"/>
                        </page>
                        <page string="Context" name="context">
                            <field name="context_data" widget="json"/>
                        </page>
                        <page string="Annotations" name="annotations">
                            <field name="annotation_ids">
                                <list string="Annotations">
                                    <field name="annotation_type"/>
                                    <field name="annotator_id"/>
                                    <field name="quality_score"/>
                                    <field name="is_approved" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_data_episode_search" model="ir.ui.view">
        <field name="name">data.episode.search</field>
        <field name="model">data.episode</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="field_id"/>
                <field name="partner_id"/>
                <field name="source"/>
                <filter name="qualified" string="Qualified" domain="[('is_qualified','=',True)]"/>
                <filter name="unqualified" string="Not Qualified" domain="[('is_qualified','=',False)]"/>
                <filter name="processed" string="Processed" domain="[('processed','=',True)]"/>
                <filter name="unprocessed" string="Not Processed" domain="[('processed','=',False)]"/>
                <filter name="group_by_source" string="Source" context="{'group_by':'source'}"/>
                <filter name="group_by_field" string="Field" context="{'group_by':'field_id'}"/>
                <filter name="group_by_partner" string="User" context="{'group_by':'partner_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_data_episode" model="ir.actions.act_window">
        <field name="name">Episodes</field>
        <field name="res_model">data.episode</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No episodes yet.</p>
            <p>Episodes capture interactions between users and the AI system.</p>
        </field>
    </record>

</odoo>