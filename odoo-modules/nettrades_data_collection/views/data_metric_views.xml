<?xml version="1.0" encoding="utf-8"?>
<!--  FILE: odoo-modules\nettrades_data_collection\views\data_metric_views.xml -->
<odoo>

    <record id="view_data_metric_tree" model="ir.ui.view">
        <field name="name">data.metric.tree</field>
        <field name="model">data.metric</field>
        <field name="arch" type="xml">
            <list string="Metrics">
                <field name="metric_type"/>
                <field name="metric_value"/>
                <field name="field_id"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="view_data_metric_form" model="ir.ui.view">
        <field name="name">data.metric.form</field>
        <field name="model">data.metric</field>
        <field name="arch" type="xml">
            <form string="Metric">
                <sheet>
                    <group>
                        <field name="metric_type"/>
                        <field name="metric_value"/>
                        <field name="field_id"/>
                        <field name="create_date" readonly="1"/>
                    </group>
                    <group string="Metadata">
                        <field name="metadata" widget="json" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_data_metric_search" model="ir.ui.view">
        <field name="name">data.metric.search</field>
        <field name="model">data.metric</field>
        <field name="arch" type="xml">
            <search>
                <field name="metric_type"/>
                <field name="field_id"/>
                <filter name="quality" string="Quality Metrics"
                        domain="[('metric_type','in',['quality_avg','rationality_avg','bias_avg'])]"/>
                <filter name="performance" string="Performance"
                        domain="[('metric_type','in',['latency_p50','latency_p95','latency_p99'])]"/>
            </search>
        </field>
    </record>

    <record id="action_data_metric" model="ir.actions.act_window">
        <field name="name">Metrics</field>
        <field name="res_model">data.metric</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>