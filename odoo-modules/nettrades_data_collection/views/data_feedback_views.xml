<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_data_feedback_tree" model="ir.ui.view">
        <field name="name">data.feedback.tree</field>
        <field name="model">data.feedback</field>
        <field name="arch" type="xml">
            <list string="Feedback">
                <field name="episode_id"/>
                <field name="feedback_type"/>
                <field name="value"/>
                <field name="user_id"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="view_data_feedback_form" model="ir.ui.view">
        <field name="name">data.feedback.form</field>
        <field name="model">data.feedback</field>
        <field name="arch" type="xml">
            <form string="Feedback">
                <sheet>
                    <group>
                        <field name="episode_id" options="{'no_create': True}"/>
                        <field name="user_id"/>
                        <field name="feedback_type"/>
                    </group>
                    <group string="Value">
                        <field name="value"/>
                        <field name="source_model"/>
                        <field name="source_id"/>
                    </group>
                    <group string="Comment">
                        <field name="comment" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_data_feedback_search" model="ir.ui.view">
        <field name="name">data.feedback.search</field>
        <field name="model">data.feedback</field>
        <field name="arch" type="xml">
            <search>
                <field name="episode_id"/>
                <field name="user_id"/>
                <field name="feedback_type"/>
                <filter name="high_value" string="Value &gt;= 4" domain="[('value','&gt;=',4)]"/>
                <filter name="good_answer" string="Good Answer" domain="[('feedback_type','=','good_answer')]"/>
            </search>
        </field>
    </record>

    <record id="action_data_feedback" model="ir.actions.act_window">
        <field name="name">Feedback</field>
        <field name="res_model">data.feedback</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>