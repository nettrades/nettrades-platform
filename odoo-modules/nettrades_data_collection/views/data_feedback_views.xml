<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Feedback on an annotation or episode -->
    <record id="view_data_feedback_tree" model="ir.ui.view">
        <field name="name">data.feedback.tree</field>
        <field name="model">data.feedback</field>
        <field name="arch" type="xml">
            <tree string="Feedback" editable="top">
                <field name="name" string="Feedback"/>
                <field name="annotation_id" string="Annotation"/>
                <field name="episode_id" string="Episode"/>
                <field name="rating" string="Rating" widget="priority"/>
                <field name="user_id" string="User"/>
                <field name="create_date" string="Date"/>
            </tree>
        </field>
    </record>

    <record id="view_data_feedback_form" model="ir.ui.view">
        <field name="name">data.feedback.form</field>
        <field name="model">data.feedback</field>
        <field name="arch" type="xml">
            <form string="Feedback">
                <sheet>
                    <group>
                        <field name="name" placeholder="Feedback summary..."/>
                        <field name="annotation_id" options="{'no_create': True}"/>
                        <field name="episode_id" options="{'no_create': True}"/>
                        <field name="user_id" readonly="1"/>
                    </group>
                    <group string="Details">
                        <field name="rating" widget="star"/>
                        <field name="feedback_text" placeholder="Detailed feedback..." widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_data_feedback_search" model="ir.ui.view">
        <field name="name">data.feedback.search</field>
        <field name="model">data.feedback</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="annotation_id"/>
                <field name="episode_id"/>
                <filter name="high_rating" string="Rating >= 4" domain="[('rating','>=',4)]"/>
            </search>
        </field>
    </record>

    <record id="action_data_feedback" model="ir.actions.act_window">
        <field name="name">Feedback</field>
        <field name="res_model">data.feedback</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>