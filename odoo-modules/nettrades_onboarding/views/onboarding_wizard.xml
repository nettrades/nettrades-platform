<!-- Section F.2 – Onboarding wizard with progress indicator -->
<odoo>
    <record id="view_onboarding_wizard" model="ir.ui.view">
        <field name="name">onboarding.wizard.form</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form string="Complete Your Profile">
                <sheet>
                    <div class="text-center mb16">
                        <h3>Profile Completeness: <field name="profile_completeness" widget="progressbar"/></h3>
                    </div>
                    <group>
                        <field name="user_type" invisible="1"/>
                        <field name="professional_summary" placeholder="A short summary of your experience"/>
                        <field name="skill_ids" widget="many2many_tags" placeholder="Add skills"/>
                        <field name="resume_pdf" widget="binary" string="Upload CV (PDF)"/>
                        <button name="parse_cv" type="object" string="Extract from CV" class="btn-secondary"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>