<?xml version="1.0" encoding="utf-8"?>
<!--
=============================================================================
NETTRADES LLM Configuration - Company Configuration Views
=============================================================================
FILE: odoo-modules/nettrades_llm_config/views/llm_company_config_views.xml

PURPOSE:
  Odoo admin interface for company-specific LLM configuration. Lets an
  administrator choose which LLM provider each company uses.

LOAD ORDER (fixed 2026-09-17):
  Actions are defined BEFORE the <menuitem> that references them, because
  Odoo processes XML top-to-bottom and resolves action references immediately.
  The previous layout put the menus first, which raised an External ID error.

  Order in this file:
    1. Action (defines action_llm_company_config)
    2. Views (define the view IDs)
    3. Menus (reference action_llm_company_config and each other)

CONDITIONAL VISIBILITY (2026-09-17, 2026-09-24):
  All conditional visibility uses Odoo 17+ inline expressions
  (invisible="not x", required="x") rather than the deprecated dictionary
  form. This is the recommended syntax and is enforced by the pre-flight
  validation in scripts/prepare-odoo-addons.sh.
=============================================================================
-->
<odoo>

    <!-- =====================================================================
         1. ACTIONS
         ===================================================================== -->

    <record id="action_llm_company_config" model="ir.actions.act_window">
        <field name="name">Company LLM Settings</field>
        <field name="res_model">nettrades.llm.company.config</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p>Configure which LLM provider each company should use for AI inference.</p>
            <p>Settings include:</p>
            <ul>
                <li>Primary LLM provider (OpenAI, Anthropic, DeepSeek, Ollama, NETTRADES.AI)</li>
                <li>Company-specific API keys and endpoints</li>
                <li>GPU overflow routing to NETTRADES.AI</li>
                <li>Fallback providers</li>
            </ul>
        </field>
    </record>

    <!-- =====================================================================
         2. VIEWS
         ===================================================================== -->

    <!-- TREE / LIST VIEW -->
    <record id="view_llm_company_config_tree" model="ir.ui.view">
        <field name="name">nettrades.llm.company.config.tree</field>
        <field name="model">nettrades.llm.company.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="company_id"/>
                <field name="provider_id" widget="badge"/>
                <field name="model_name"/>
                <field name="gpu_overflow_enabled" widget="boolean_toggle"/>
                <field name="fallback_provider_id" widget="badge"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_llm_company_config_form" model="ir.ui.view">
        <field name="name">nettrades.llm.company.config.form</field>
        <field name="model">nettrades.llm.company.config</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_test_connection" string="Test Connection"
                            type="object" class="btn-primary"/>
                    <field name="active" widget="boolean_toggle"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="company_id" placeholder="Select Company"/>
                            <span class="o_stat_info" invisible="not active">(Active)</span>
                        </h1>
                    </div>

                    <!-- PRIMARY PROVIDER -->
                    <group string="Primary LLM Provider">
                        <field name="provider_id" options="{'no_create': True}" required="True"/>
                        <field name="override_model"/>
                        <field name="model_name" invisible="not override_model" required="override_model"/>
                        <field name="override_api_key"/>
                        <field name="api_key" password="True" invisible="not override_api_key" required="override_api_key"/>
                        <field name="override_api_base_url"/>
                        <field name="api_base_url" invisible="not override_api_base_url"/>
                    </group>

                    <!-- FALLBACK PROVIDER -->
                    <group string="Fallback Provider">
                        <field name="fallback_provider_id" options="{'no_create': True}"/>
                        <field name="fallback_model_name" invisible="not fallback_provider_id"/>
                    </group>

                    <!-- GPU OVERFLOW -->
                    <group string="GPU Overflow Configuration">
                        <field name="gpu_overflow_enabled"/>
                        <field name="gpu_overflow_threshold" invisible="not gpu_overflow_enabled"/>
                        <field name="use_nettrades_ai_for_training"/>
                        <field name="nettrades_ai_url"/>
                        <field name="nettrades_ai_api_key" widget="password"/>
                    </group>

                    <!-- PERFORMANCE -->
                    <group string="Performance Settings">
                        <field name="temperature"/>
                        <field name="request_timeout"/>
                        <field name="max_retries"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- =====================================================================
         3. MENUS
         ===================================================================== -->

    <menuitem id="menu_llm_config_root"
              name="LLM Configuration"
              parent="nettrades_core.menu_nettrades_root"
              sequence="60"/>

    <menuitem id="menu_llm_company_config"
              name="Company LLM Settings"
              parent="menu_llm_config_root"
              action="action_llm_company_config"/>

</odoo>