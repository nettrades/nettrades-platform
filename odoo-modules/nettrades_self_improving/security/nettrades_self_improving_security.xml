<?xml version="1.0" encoding="utf-8"?>
<!--  FILE: odoo-modules/nettrades_self_improving/security/nettrades_self_improving_security.xml -->
<odoo>

    <record id="group_self_improving_manager" model="res.groups">
        <field name="name">NETTRADES Self-Improving Manager</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_loop_cycle_company" model="ir.rule">
        <field name="name">Loop Cycle: Multi-company</field>
        <field name="model_id" ref="model_loop_cycle"/>
        <field name="domain_force">
            ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
        </field>
        <field name="global" eval="True"/>
    </record>

</odoo>