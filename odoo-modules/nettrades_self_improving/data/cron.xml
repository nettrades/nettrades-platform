<?xml version="1.0" encoding="utf-8"?>
<!--  FILE: odoo-modules/nettrades_self_improving/data/cron.xml -->
<odoo>
    <data noupdate="1">

        <record id="cron_check_triggers" model="ir.cron">
            <field name="name">Self-Improving: Check Triggers</field>
            <field name="model_id" ref="model_trigger_config"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_triggers()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_resume_cycles" model="ir.cron">
            <field name="name">Self-Improving: Resume Pending Cycles</field>
            <field name="model_id" ref="model_loop_orchestrator"/>
            <field name="state">code</field>
            <field name="code">model._cron_resume_pending_cycles()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>