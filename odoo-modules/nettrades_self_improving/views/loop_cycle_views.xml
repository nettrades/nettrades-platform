<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_loop_cycle_tree" model="ir.ui.view">
        <field name="name">loop.cycle.tree</field>
        <field name="model">loop.cycle</field>
        <field name="arch" type="xml">
            <list string="Cycles">
                <field name="name"/>
                <field name="origin"/>
                <field name="started_at"/>
                <field name="completed_at"/>
                <field name="status" widget="badge"/>
                <field name="improvement"/>
                <field name="duration_seconds"/>
            </list>
        </field>
    </record>

    <record id="view_loop_cycle_form" model="ir.ui.view">
        <field name="name">loop.cycle.form</field>
        <field name="model">loop.cycle</field>
        <field name="arch" type="xml">
            <form string="Loop Cycle">
                <header>
                    <button name="action_rerun" type="object" string="Re-run Cycle"
                            class="btn-secondary"
                            invisible="status not in ('completed', 'failed', 'skipped')"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Timeline">
                            <field name="started_at"/>
                            <field name="completed_at"/>
                            <field name="duration_seconds" readonly="1"/>
                            <field name="origin"/>
                        </group>
                        <group string="Results">
                            <field name="improvement"/>
                            <field name="episode_count"/>
                            <field name="trigger_name"/>
                        </group>
                    </group>
                    <group string="Links">
                        <field name="trigger_event_id"/>
                        <field name="dataset_id"/>
                        <field name="training_job_id"/>
                        <field name="result_model_id"/>
                        <field name="model_id"/>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="What is this cycle for?"/>
                        </page>
                        <page string="State Data">
                            <field name="state_data" widget="json"/>
                        </page>
                        <page string="Metrics">
                            <field name="metrics" widget="json"/>
                        </page>
                        <page string="Results (raw)">
                            <field name="results" widget="json"/>
                        </page>
                        <page string="Error" invisible="not error_message">
                            <field name="error_message"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_loop_cycle_kanban" model="ir.ui.view">
        <field name="name">loop.cycle.kanban</field>
        <field name="model">loop.cycle</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="status"/>
                <field name="improvement"/>
                <field name="started_at"/>
                <field name="episode_count"/>
                <field name="trigger_name"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <t t-esc="record.name.value"/>
                                </strong>
                                <div>
                                    Status:
                                    <span class="badge rounded-pill text-bg-info">
                                        <t t-esc="record.status.value"/>
                                    </span>
                                </div>
                                <div t-if="record.trigger_name.value">
                                    Trigger: <t t-esc="record.trigger_name.value"/>
                                </div>
                                <div>
                                    Episodes: <t t-esc="record.episode_count.value"/>
                                </div>
                                <div t-if="record.improvement.value">
                                    Improvement: <t t-esc="record.improvement.value"/>%
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_loop_cycle_search" model="ir.ui.view">
        <field name="name">loop.cycle.search</field>
        <field name="model">loop.cycle</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="status"/>
                <filter name="running" string="Running"
                        domain="[('status','not in',('completed','failed','skipped'))]"/>
                <filter name="completed" string="Completed" domain="[('status','=','completed')]"/>
                <filter name="failed" string="Failed" domain="[('status','=','failed')]"/>
                <filter name="group_by_status" string="Status"
                        context="{'group_by':'status'}"/>
                <filter name="group_by_origin" string="Origin"
                        context="{'group_by':'origin'}"/>
            </search>
        </field>
    </record>

    <record id="action_loop_cycle" model="ir.actions.act_window">
        <field name="name">Cycles</field>
        <field name="res_model">loop.cycle</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No cycles yet.</p>
            <p>Cycles are created automatically when a trigger fires, or manually from the configuration screen.</p>
        </field>
    </record>

</odoo>