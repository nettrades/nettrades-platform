<?xml version="1.0" encoding="UTF-8"?>
<!--
=============================================================================
NETTRADES Fairness – Security Groups
=============================================================================
FILE: odoo-modules/nettrades_fairness/security/fairness_security.xml

PURPOSE:
  Defines security groups for the fairness module.

GROUPS:
  1. Fairness Administrator – full access to configuration, audits, and flags
  2. Fairness Reviewer – read-only access to audits, can review flags
  3. Fairness Auditor – read-only access to audits and metrics
=============================================================================
-->
<odoo>
    <!-- Fairness Administrator – full access -->
    <record id="group_fairness_admin" model="res.groups">
        <field name="name">Fairness Administrator</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="implied_ids" eval="[(4, ref('base.group_system'))]"/>
        <field name="comment">Full access to fairness configuration, audits, and flags.</field>
    </record>

    <!-- Fairness Reviewer – can review flags -->
    <record id="group_fairness_reviewer" model="res.groups">
        <field name="name">Fairness Reviewer</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can view audits and review flags.</field>
    </record>

    <!-- Fairness Auditor – read-only -->
    <record id="group_fairness_auditor" model="res.groups">
        <field name="name">Fairness Auditor</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Read-only access to audits and metrics.</field>
    </record>
</odoo>