<?xml version="1.0" encoding="UTF-8"?>
<!--
=============================================================================
NETTRADES Bridge - Company Configuration Views
=============================================================================
FILE: odoo-modules/nettrades_bridge/views/bridge_company_config_views.xml

PURPOSE:
  This file defines the Odoo admin interface for per-company bridge
  configuration. It allows administrators to override global settings
  for specific companies.
  Per-company bridge configuration overrides. The tree view lists all
  overrides; the form view lets an admin edit one.

UPDATES (2026-09):
  - Migrated the deprecated dictionary-form conditional visibility syntax
    to inline expressions (e.g. invisible="not override_bridge_mode").
    The old syntax, which combined a separate attribute with a dictionary
    of conditions, is rejected by Odoo 17+ at view load time.
  - The `active` field is now declared on the model, so the tree view
    resolves it correctly.
=============================================================================
-->
<odoo>
    <!-- ACTION -->
    <record id="action_bridge_company_config" model="ir.actions.act_window">
        <field name="name">Company Bridge Configurations</field>
        <field name="res_model">nettrades.bridge.company.config</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p>Override bridge settings for specific companies.</p>
            <p>These settings take precedence over the global configuration.</p>
        </field>
    </record>

    <!-- TREE VIEW -->
    <record id="view_bridge_company_config_tree" model="ir.ui.view">
        <field name="name">nettrades.bridge.company.config.tree</field>
        <field name="model">nettrades.bridge.company.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="company_id"/>
                <field name="bridge_mode"/>
                <field name="override_features"/>
                <field name="gpu_overflow_enabled"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_bridge_company_config_form" model="ir.ui.view">
        <field name="name">nettrades.bridge.company.config.form</field>
        <field name="model">nettrades.bridge.company.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>Company Bridge Configuration</h1>
                    </div>

                    <group>
                        <field name="company_id" options="{'no_create': True}"/>
                        <field name="active"/>
                    </group>

                    <group string="Mode Override">
                        <field name="override_bridge_mode"/>
                        <field name="bridge_mode" invisible="not override_bridge_mode"/>
                    </group>

                    <group string="Feature Flags Override">
                        <field name="override_features"/>
                        <field name="enable_remote_recruitment" invisible="not override_features"/>
                        <field name="enable_remote_freelance" invisible="not override_features"/>
                        <field name="enable_remote_gpu" invisible="not override_features"/>
                        <field name="enable_remote_vision" invisible="not override_features"/>
                        <field name="enable_remote_action" invisible="not override_features"/>
                    </group>

                    <group string="GPU Overflow Override">
                        <field name="override_gpu_overflow"/>
                        <field name="gpu_overflow_enabled" invisible="not override_gpu_overflow"/>
                        <field name="gpu_overflow_threshold" invisible="not override_gpu_overflow"/>
                    </group>

                    <group string="Remote Connection Override">
                        <field name="override_remote_url"/>
                        <field name="remote_brain_url" invisible="not override_remote_url"/>
                        <field name="remote_brain_api_key" password="True" invisible="not override_remote_url"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>