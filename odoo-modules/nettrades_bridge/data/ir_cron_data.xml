<!-- file: nettrades_bridge/data/ir_cron_data.xml -->
<odoo>
    <data noupdate="1">
        <record id="ir_cron_start_discovery" model="ir.cron">
            <field name="name">NETTRADES Bridge: Ensure mDNS Discovery Running</field>
            <field name="model_id" ref="model_nettrades_bridge_discovery"/>
            <field name="state">code</field>
            <field name="code">
if not env['nettrades_bridge.discovery'].is_running():
    env['nettrades_bridge.discovery'].start_discovery()
            </field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
        </record>
    </data>
</odoo>