<?xml version="1.0" encoding="utf-8"?>
<!--
    Qualified Professionals – manually maintained list of experts
    who have been verified for a specific field.
    Administrators can add or remove professionals here.
-->
<odoo>
    <record id="view_qualified_professional_tree" model="ir.ui.view">
        <field name="name">qualified.professional.tree</field>
        <field name="model">qualified.professional</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="partner_id"
                       help="The verified professional."/>
                <field name="field_id"
                       help="The field in which this professional is qualified."/>
                <field name="points_per_vote"
                       help="Overrides the field's default qualified-vote points for this specific professional."/>
                <field name="is_active"
                       help="Uncheck to temporarily remove this professional from matching without deleting the record."/>
            </tree>
        </field>
    </record>

    <record id="view_qualified_professional_form" model="ir.ui.view">
        <field name="name">qualified.professional.form</field>
        <field name="model">qualified.professional</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="partner_id"/>
                        <field name="field_id"/>
                        <field name="points_per_vote"/>
                        <field name="is_active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <act_window id="action_qualified_professional"
                name="Qualified Professionals"
                res_model="qualified.professional"
                view_mode="tree,form"/>

    <menuitem id="menu_qualified_professional"
              name="Qualified Professionals"
              parent="base.menu_administration"
              action="action_qualified_professional"/>
</odoo>