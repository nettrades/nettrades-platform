<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_qualified_professional_tree" model="ir.ui.view">
        <field name="name">qualified.professional.tree</field>
        <field name="model">qualified.professional</field>
        <field name="arch" type="xml">
            <list>
                <field name="partner_id"/>
                <field name="field_id"/>
                <field name="is_active"/>
            </list>
        </field>
    </record>

    <record id="view_qualified_professional_form" model="ir.ui.view">
        <field name="name">qualified.professional.form</field>
        <field name="model">qualified.professional</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="partner_id"/>
                        <field name="field_id"/>
                        <field name="is_active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_qualified_professional" model="ir.actions.act_window">
        <field name="name">Qualified Professionals</field>
        <field name="res_model">qualified.professional</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>