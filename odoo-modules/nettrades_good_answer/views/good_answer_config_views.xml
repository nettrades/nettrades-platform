<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_good_answer_config_form" model="ir.ui.view">
        <field name="name">good.answer.config.form</field>
        <field name="model">good.answer.config</field>
        <field name="arch" type="xml">
            <form string="Good Answer Settings">
                <sheet>
                    <group>
                        <field name="base_points_per_vote"/>
                        <field name="qualified_points_per_vote"/>
                        <field name="reputation_threshold_for_charging"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <act_window id="action_good_answer_config"
                name="Good Answer Settings"
                res_model="good.answer.config"
                view_mode="form"
                target="inline"/>
</odoo>