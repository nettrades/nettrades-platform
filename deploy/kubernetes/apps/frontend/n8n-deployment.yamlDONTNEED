# =============================================================================
# Section: C, G – n8n workflow automation.
# Deployed as a single replica; uses the internal PostgreSQL for workflow storage.
# =============================================================================
apiVersion: apps/v1
kind: Deployment
metadata:
  name: n8n
  namespace: frontend
spec:
  replicas: 1
  selector:
    matchLabels:
      app: n8n
  template:
    metadata:
      labels:
        app: n8n
    spec:
      containers:
        - name: n8n
          image: n8nio/n8n:latest
          env:
            - name: N8N_HOST
              value: n8n.nettrades.ai
            - name: N8N_PROTOCOL
              value: https
            - name: N8N_ENCRYPTION_KEY
              valueFrom:
                secretKeyRef:
                  name: n8n-secret
                  key: encryption-key
            - name: DB_TYPE
              value: postgresdb
            - name: DB_POSTGRESDB_HOST
              value: odoo-db-rw.backend.svc.cluster.local
            - name: DB_POSTGRESDB_PORT
              value: "5432"
            - name: DB_POSTGRESDB_DATABASE
              value: odoo         # reuse Odoo DB or create a separate n8n database
            - name: DB_POSTGRESDB_USER
              value: odoo
            - name: DB_POSTGRESDB_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: postgres-secret
                  key: password
          ports:
            - containerPort: 5678
          volumeMounts:
            - name: n8n-data
              mountPath: /home/node/.n8n
      volumes:
        - name: n8n-data
          persistentVolumeClaim:
            claimName: n8n-data-pvc
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: n8n-data-pvc
  namespace: frontend
spec:
  accessModes: [ReadWriteOnce]
  resources:
    requests:
      storage: 10Gi
---
apiVersion: v1
kind: Service
metadata:
  name: n8n
  namespace: frontend
spec:
  selector:
    app: n8n
  ports:
    - port: 5678
      targetPort: 5678