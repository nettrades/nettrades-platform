# =============================================================================
# Section: G – Example Terraform variables for the Talos/Proxmox module.
# Copy this file to terraform.tfvars and replace the placeholder values.
# NEVER commit the real terraform.tfvars to version control.
# =============================================================================
proxmox_api_url          = "https://192.168.1.100:8006/api2/json"
proxmox_api_token_id     = "your-token-id"
proxmox_api_token_secret = "your-token-secret"
proxmox_node             = "pve1"
proxmox_storage          = "local-lvm"
network_bridge           = "vmbr0"
gateway                  = "192.168.1.1"
cluster_name             = "nettrades"
control_plane_count      = 3
worker_count             = 3
control_plane_ips        = ["10.0.0.10", "10.0.0.11", "10.0.0.12"]
worker_ips               = ["10.0.0.20", "10.0.0.21", "10.0.0.22"]
talos_template_id        = 9000    # Proxmox VM template ID for Talos image