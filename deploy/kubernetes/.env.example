# Inference backend selection
# Set one of the following (the agent auto-detects priority):
GPUSTACK_SERVER_URL=http://gpustack:80          # if GPUStack is available
# VLLM_BASE_URL=http://vllm:8000                # if vLLM is used on single VM
# LLM_BASE_URL=http://llama-cpp:8080/v1         # default llama.cpp
# IGNORE THE VALUE BELOW THIS:
# POSTGRES_PASSWORD=changeit
# FORGEJO_INTERNAL_DB_PASSWORD=changeit
# FORGEJO_CLIENT_DB_PASSWORD=changeit
# LANGGRAPH_API_KEY=changeit
# ODOO_API_KEY=changeit
# MCP_API_KEY=changeit
# GPUSTACK_JWT_SECRET=changeit
# WIREGUARD_CONTROLLER_PRIVATE_KEY=changeit
# VLLM_API_KEY=changeit   # if GPU
# REGISTRY_PASSWORD=changeit
# DOMAIN=nettrades.ai
# ADMIN_EMAIL=admin@nettrades.ai
# ADMIN_PASSWORD=changeit
# FORGEJO_DB_PASSWORD=changeit
# FORGEJO_SECRET_KEY=changeit
# JWT_SECRET=changeit
# GRAFANA_PASSWORD=changeit
# LLAMA_API_KEY=dummy
# WIREGUARD_PRIVATE_KEY=changeit
# WIREGUARD_PUBLIC_KEY=changeit
# DATABASE_URL=postgresql://odoo:${POSTGRES_PASSWORD}@postgres:5432/odoo