FROM python:3.12-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY src/core/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Install Unsloth for fine-tuning
RUN pip install --no-cache-dir unsloth

# Install Axolotl for supervised fine-tuning
RUN pip install --no-cache-dir axolotl

# Copy the source code
COPY src/core/ .

# Set the entry point
CMD ["python", "-m", "self_improving_service"]