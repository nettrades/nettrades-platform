# =============================================================================
# NETTRADES.AI – Odoo 19 CE with Custom Modules
# =============================================================================
# FILE: deploy/docker/Dockerfile.odoo
#
# UPDATES (2026-09):
#   - Split pip installation into two stages. The first stage pre-installs
#     pure-Python packages that Debian ships without RECORD files
#     (typing-extensions, idna, charset-normalizer) using --ignore-installed
#     so they land in /usr/local/lib/python3.12/dist-packages and shadow
#     the Debian copies. Without this, pip tries to uninstall the Debian
#     copies during stage 2 and aborts with "RECORD file not found".
#
#   - Stage 2 does NOT use --ignore-installed. This is critical: using it
#     there causes pip to upgrade cryptography to 50.x, which is
#     incompatible with the Debian-provided pyOpenSSL 23.2.0 that ships
#     inside odoo:19.0. The symptom is
#         AttributeError: module 'lib' has no attribute 'GEN_EMAIL'
#     every time Odoo imports its mail server module.
#
#   - cryptography, pyOpenSSL, and cffi are deliberately NOT listed in
#     either stage. pdfminer.six requires cryptography>=36 and Debian's
#     41.0.7 satisfies that, so pip leaves the Debian stack alone.
#
# UPDATES (2026-10):
#   - Added `packaging` and `pydantic` to stage 1.
#
#     Why these two, and why stage 1:
#
#       packaging:
#         Odoo uses the `packaging` library to parse the version
#         constraints declared in a module's `external_dependencies`
#         manifest field. Without it, installing any module whose
#         manifest declares something like `pydantic>=2.0.0` fails at
#         the "check_external_dependencies" step with:
#             Exception: Package `packaging` is required to parse
#             `pydantic>=2.0.0` external dependency and is not installed
#         This was blocking the install of every llm_* service module
#         (llm_openai, llm_anthropic, llm_ollama, llm_mistral).
#
#       pydantic:
#         The Apexive llm module and its service submodules declare
#         `pydantic>=2.0.0` in external_dependencies. Debian ships
#         pydantic 1.x as python3-pydantic, which does not satisfy the
#         constraint. Installing pydantic 2.x with --ignore-installed
#         places it in /usr/local/lib/python3.12/dist-packages, where
#         it shadows the Debian 1.x copy.
#
#   - Added `mcp` to stage 2.
#
#     Why:
#       llm_openai depends on llm_tool, and llm_tool declares `mcp`
#       in external_dependencies. Without the package, Odoo refuses to
#       install llm_openai with:
#           MissingDependency: External dependency 'mcp' not installed
#       and in the UI:
#           Unable to install module "llm_tool" because an external
#           dependency is not met: mcp
#
#     `mcp` is the Model Context Protocol SDK published by Anthropic.
#     It is a normal PyPI package with a manylinux wheel; it does not
#     shadow anything Debian ships, so it belongs in stage 2 where pip
#     installs the rest of the third-party extras without
#     --ignore-installed.
# =============================================================================

FROM odoo:19.0

# Switch to root to install additional packages
USER root

# Install system packages needed by the container
RUN apt-get update && apt-get install -y \
    curl \
    git \
    gcc \
    python3-dev \
    wireguard-tools \
    iputils-ping \
    && rm -rf /var/lib/apt/lists/*

# -----------------------------------------------------------------------------
# Stage 1: shadow Debian-provided pure-Python packages
# -----------------------------------------------------------------------------
# The odoo:19.0 base image installs several Python packages via apt. Those
# packages have no RECORD file, so pip cannot uninstall them. Whenever a
# transitive dependency in stage 2 needs a newer version of one of these,
# pip tries to uninstall and fails.
#
# We fix this by installing our own newer copies into /usr/local/lib with
# --ignore-installed. That path precedes /usr/lib/python3/dist-packages in
# sys.path, so the newer copies shadow the Debian ones and pip is satisfied
# without ever touching the Debian packages.
#
# Package list rationale:
#   - typing-extensions  : required by openai, pydantic, anyio (>=4.14)
#   - idna               : required by anyio, httpx2
#   - charset-normalizer : required by pdfminer.six
#   - packaging          : required by Odoo to parse external_dependencies
#                          version constraints like `pydantic>=2.0.0`
#   - pydantic           : required by the Apexive llm module and every
#                          llm_* service submodule. Debian ships
#                          pydantic 1.x, which does not satisfy the
#                          pydantic>=2.0.0 constraint the manifests
#                          declare.
# -----------------------------------------------------------------------------
RUN pip3 install --break-system-packages --no-cache-dir --ignore-installed \
    'typing-extensions>=4.14' \
    'idna>=3.7' \
    'charset-normalizer>=3' \
    'packaging>=24.0' \
    'pydantic>=2.0.0'

# -----------------------------------------------------------------------------
# Stage 2: install the remaining Python extras
# -----------------------------------------------------------------------------
# Deliberately WITHOUT --ignore-installed. Everything pip needs from Debian
# is either already satisfied (cryptography 41.0.7, pyOpenSSL 23.2.0, cffi)
# or has been pre-shadowed by stage 1.
#
# Package list rationale:
#   - pandas, numpy, scikit-learn : data processing in Odoo-side scripts
#   - requests                    : HTTP client for Odoo controllers
#   - openai, anthropic           : third-party LLM SDKs used by
#                                   nettrades_llm_config and connectors
#   - pdfplumber                  : CV / resume parsing in onboarding
#   - mcp                         : Model Context Protocol SDK. Required
#                                   by llm_tool, which llm_openai depends
#                                   on. Missing it blocks llm_openai from
#                                   installing, which in turn blocks the
#                                   llm.provider "Service" dropdown from
#                                   being populated.
# -----------------------------------------------------------------------------
RUN pip3 install --break-system-packages --no-cache-dir \
    pandas \
    numpy \
    scikit-learn \
    requests \
    openai \
    anthropic \
    pdfplumber \
    mcp

# Copy custom NETTRADES modules
COPY odoo-modules/ /mnt/extra-addons/

# Set the correct ownership
USER odoo