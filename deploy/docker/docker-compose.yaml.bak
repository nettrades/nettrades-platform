# =============================================================================
# FILE: deploy/docker/docker-compose.yaml
# =============================================================================
# PURPOSE:
#   Defines all services for a single-VM deployment of the NETTRADES platform.
#
# SERVICES:
#   - Traefik: Reverse proxy with automatic Let's Encrypt SSL
#   - PostgreSQL 18 with pgvector: RAG embeddings & main database
#   - Postgres Exporter: Prometheus metrics for PostgreSQL
#   - Valkey 8: BSD-licensed in-memory store (sessions, ORM cache, bus)
#   - Odoo 19 CE: ERP, Marketplace, and AI Hub
#   - Forgejo 15.0 LTS: Self-hosted Git server
#   - LangGraph Agent: Durable AI orchestration
#   - Odoo Proxy: HTTP JSON-RPC shim (replaces mcp-odoo)
#   - GPUStack: GPU management and inference
#   - llama.cpp / vLLM: Inference engines
#   - Prometheus: Metrics collection
#   - Grafana: Visualisation
#   - Node Exporter: System metrics for Prometheus
#
# KEY FEATURES:
#   - All services are production-ready with pinned versions.
#   - Forgejo 15.0 LTS is supported until July 2027.
#   - GPUStack v2.1.2 is the current stable release.
#   - Valkey 8 replaces Redis for session storage, ORM cache, and bus notifications.
#   - GPUStack's built-in Prometheus and Grafana are DISABLED on the central
#     deployment. Metrics are scraped by the external Prometheus and visualised
#     in the external Grafana.
#   - Client companies running their own GPUStack server (Trusted Mode) retain
#     the built-in Grafana for anonymous Viewer access to GPU-level dashboards.
#
# MODIFICATIONS:
#   - Added new self-improving modules to Odoo addons_path.
#   - Added bridge module for hub-and-spoke routing.
#   - Added data collection, trigger, and loop modules.
#   - Added fairness module to Odoo addons.
#   - Updated environment variables for fairness evaluation.
#   - Replaced mcp-odoo with odoo-proxy service.
#   - Added node_exporter for system-level metrics.
# =============================================================================

version: '3.8'

# -----------------------------------------------------------------------------
# Networks
# -----------------------------------------------------------------------------
networks:
  web:
    external: true
  internal:
    driver: bridge

# -----------------------------------------------------------------------------
# Services
# -----------------------------------------------------------------------------
services:

  # =========================================================================
  # 1. TRAEFIK – Reverse Proxy with Automatic Let's Encrypt SSL
  # =========================================================================
  traefik:
    image: traefik:v3.6.13
    command:
      - --providers.docker=true
      - --providers.docker.endpoint=unix:///var/run/docker.sock
      - --entrypoints.web.address=:80
      - --entrypoints.websecure.address=:443
      - --certificatesresolvers.letsencrypt.acme.httpchallenge=true
      - --certificatesresolvers.letsencrypt.acme.httpchallenge.entrypoint=web
      - --certificatesresolvers.letsencrypt.acme.email=${ADMIN_EMAIL}
      - --certificatesresolvers.letsencrypt.acme.storage=/letsencrypt/acme.json
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - ./traefik-data:/letsencrypt
    networks:
      - web
    restart: unless-stopped
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

  # =========================================================================
  # 2. POSTGRESQL with pgvector – RAG Embeddings & Main Database
  # =========================================================================
  postgres:
    image: pgvector/pgvector:pg18
    environment:
      POSTGRES_DB: odoo
      POSTGRES_USER: odoo
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
    volumes:
      - ./postgres-data:/var/lib/postgresql/data
    networks:
      - internal
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U odoo"]
      interval: 10s
      timeout: 5s
      retries: 5
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

  # =========================================================================
  # 3. POSTGRES EXPORTER – Prometheus Metrics for PostgreSQL
  # =========================================================================
  postgres-exporter:
    image: prometheuscommunity/postgres-exporter:latest
    environment:
      DATA_SOURCE_NAME: "postgresql://odoo:${POSTGRES_PASSWORD}@postgres:5432/odoo?sslmode=disable"
    networks:
      - internal
    restart: unless-stopped
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

  # =========================================================================
  # 4. VALKEY – BSD-licensed in-memory store (sessions, ORM cache, bus)
  # =========================================================================
  valkey:
    image: valkey/valkey:8-alpine
    container_name: valkey
    restart: unless-stopped
    networks:
      - internal
    volumes:
      - ./valkey-data:/data
    command: valkey-server --appendonly yes --save 900 1 --save 300 10
    security_opt:
      - no-new-privileges:true
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

  # =========================================================================
  # 5. ODOO 19 CE – ERP, Marketplace, and AI Hub
  # =========================================================================
  odoo:
    image: odoo:19.0
    volumes:
      - ./addons:/mnt/extra-addons
      - ./odoo-data:/var/lib/odoo
      - ./config/odoo.conf:/etc/odoo/odoo.conf
    environment:
      - HOST=postgres
      - PORT=5432
      - USER=odoo
      - PASSWORD=${POSTGRES_PASSWORD}
      # Fairness evaluation API keys
      - OPENAI_API_KEY=${OPENAI_API_KEY:-}
      - ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY:-}
    labels:
      - traefik.enable=true
      - traefik.http.routers.odoo.rule=Host(`${DOMAIN}`)
      - traefik.http.services.odoo.loadbalancer.server.port=8069
      - traefik.http.middlewares.odoo-ratelimit.ratelimit.average=100
      - traefik.http.routers.odoo.middlewares=odoo-ratelimit
    networks:
      - web
      - internal
    restart: unless-stopped
    depends_on:
      postgres:
        condition: service_healthy
      valkey:
        condition: service_started
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

  # =========================================================================
  # 6. FORGEJO 15.0 LTS – Self-hosted Git Server
  # =========================================================================
  forgejo:
    image: codeberg.org/forgejo/forgejo:15.0
    volumes:
      - ./forgejo-data:/data
    environment:
      - FORGEJO__database__DB_TYPE=postgres
      - FORGEJO__database__HOST=postgres:5432
      - FORGEJO__database__NAME=forgejo
      - FORGEJO__database__USER=forgejo
      - FORGEJO__database__PASSWD=${FORGEJO_DB_PASSWORD}
      - FORGEJO__security__SECRET_KEY=${FORGEJO_SECRET_KEY}
      - FORGEJO__security__INTERNAL_TOKEN=${JWT_SECRET}
    labels:
      - traefik.enable=true
      - traefik.http.routers.forgejo.rule=Host(`git.${DOMAIN}`)
      - traefik.http.services.forgejo.loadbalancer.server.port=3000
    networks:
      - web
      - internal
    restart: unless-stopped
    depends_on:
      postgres:
        condition: service_healthy
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

  # =========================================================================
  # 7. LANGGRAPH AGENT – Durable AI Orchestration
  # =========================================================================
  langgraph:
    build: ../langgraph-agent
    image: langgraph-agent:latest
    container_name: langgraph
    restart: unless-stopped
    networks:
      - web
      - internal
    environment:
      # LLM Configuration (llama.cpp / vLLM)
      - LLM_BASE_URL=http://llama-cpp:8080/v1
      - LLAMA_API_KEY=dummy
      - LLM_MODEL=deepseek-r1:1.5b
      # LangGraph API Key (used by the /invoke endpoint)
      - LANGGRAPH_API_KEY=${LANGGRAPH_API_KEY}
      # Database connection (PostgreSQL + pgvector)
      - DATABASE_URL=postgresql://odoo:${POSTGRES_PASSWORD}@postgres:5432/odoo
      # Odoo Proxy Integration (NEW – replaces the old mcp-odoo)
      - ODOO_PROXY_URL=${ODOO_PROXY_URL:-http://odoo-proxy:3000}
      - ODOO_API_KEY=${PROXY_API_KEY:-${ODOO_API_KEY}}
      - USE_ODOO_PROXY=${USE_ODOO_PROXY:-true}
      # Odoo connection details (used by the proxy to talk to Odoo)
      - ODOO_DB=${ODOO_DB:-odoo}
      - ODOO_USER=${ODOO_USER:-1}
      - ODOO_PASSWORD=${ADMIN_PASSWORD}
    command: ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]
    labels:
      - traefik.enable=true
      - traefik.http.routers.langgraph.rule=Host(`langgraph.${DOMAIN}`)
      - traefik.http.services.langgraph.loadbalancer.server.port=8000
      - traefik.http.middlewares.langgraph-ratelimit.ratelimit.average=50
      - traefik.http.routers.langgraph.middlewares=langgraph-ratelimit
    depends_on:
      - postgres
      - valkey
      - odoo-proxy
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

  # =========================================================================
  # 8. ODOO PROXY – HTTP JSON-RPC Shim (NEW – replaces mcp-odoo)
  # =========================================================================
  odoo-proxy:
    build: ../odoo-proxy
    image: odoo-proxy:latest
    container_name: odoo-proxy
    restart: unless-stopped
    networks:
      - internal
    environment:
      - ODOO_URL=${ODOO_URL:-http://odoo:8069}
      - ODOO_DB=${ODOO_DB:-odoo}
      - ODOO_USER=${ODOO_USER:-1}
      - ODOO_PASSWORD=${ADMIN_PASSWORD}
      - PROXY_API_KEY=${PROXY_API_KEY:-${ODOO_API_KEY}}
      - LOG_LEVEL=${LOG_LEVEL:-info}
    ports:
      - "3000:3000"
    depends_on:
      - odoo
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

  # =========================================================================
  # 9. GPUSTACK – GPU Management and Inference
  # =========================================================================
  gpustack:
    image: gpustack/gpustack:latest
    container_name: gpustack
    restart: unless-stopped
    networks:
      - web
      - internal
    environment:
      - GPUSTACK_JWT_SECRET=${GPUSTACK_JWT_SECRET}
      - GPUSTACK_GRAFANA_URL=https://grafana.${DOMAIN}
    volumes:
      - ./gpustack-data:/data
    labels:
      - traefik.enable=true
      - traefik.http.routers.gpustack.rule=Host(`gpustack.${DOMAIN}`)
      - traefik.http.services.gpustack.loadbalancer.server.port=8080
    depends_on:
      - postgres
      - valkey
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

  # =========================================================================
  # 10. LLAMA.CPP – CPU Inference Engine
  # =========================================================================
  llama-cpp:
    image: ggerganov/llama.cpp:full
    container_name: llama-cpp
    restart: unless-stopped
    networks:
      - internal
    volumes:
      - ./llama-cpp-data:/models
    environment:
      - LLAMA_SERVER_MODEL=/models/DeepSeek-R1-Distill-Qwen-1.5B-Q4_K_M.gguf
      - LLAMA_SERVER_HOST=0.0.0.0
      - LLAMA_SERVER_PORT=8080
      - LLAMA_SERVER_N_GPU_LAYERS=0
    ports:
      - "8080:8080"
    command: ["-m", "/models/DeepSeek-R1-Distill-Qwen-1.5B-Q4_K_M.gguf", "--host", "0.0.0.0", "--port", "8080", "-ngl", "0"]
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

  # =========================================================================
  # 11. PROMETHEUS – Metrics Collection
  # =========================================================================
  prometheus:
    image: prom/prometheus:latest
    container_name: prometheus
    restart: unless-stopped
    networks:
      - web
      - internal
    volumes:
      - ./prometheus.yml:/etc/prometheus/prometheus.yml
      - ./prometheus-data:/prometheus
    command:
      - '--config.file=/etc/prometheus/prometheus.yml'
      - '--storage.tsdb.path=/prometheus'
    labels:
      - traefik.enable=true
      - traefik.http.routers.prometheus.rule=Host(`prometheus.${DOMAIN}`)
      - traefik.http.services.prometheus.loadbalancer.server.port=9090
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

  # =========================================================================
  # 12. GRAFANA – Visualisation Dashboard
  # =========================================================================
  grafana:
    image: grafana/grafana:latest
    container_name: grafana
    restart: unless-stopped
    networks:
      - web
      - internal
    volumes:
      - ./grafana-data:/var/lib/grafana
      - ./grafana-dashboards:/etc/grafana/provisioning/dashboards
    environment:
      - GF_SECURITY_ADMIN_USER=admin
      - GF_SECURITY_ADMIN_PASSWORD=${GRAFANA_PASSWORD}
      - GF_INSTALL_PLUGINS=grafana-piechart-panel
    labels:
      - traefik.enable=true
      - traefik.http.routers.grafana.rule=Host(`grafana.${DOMAIN}`)
      - traefik.http.services.grafana.loadbalancer.server.port=3000
    depends_on:
      - prometheus
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

  # =========================================================================
  # 13. NODE EXPORTER – System Metrics for Prometheus
  # =========================================================================
  node_exporter:
    image: prom/node-exporter:latest
    container_name: node_exporter
    restart: unless-stopped
    networks:
      - internal
    pid: host
    volumes:
      - /proc:/host/proc:ro
      - /sys:/host/sys:ro
      - /:/rootfs:ro
    command:
      - --path.procfs=/host/proc
      - --path.sysfs=/host/sys
      - --collector.filesystem.mount-points-exclude=^/(sys|proc|dev|host|etc)($$|/)
    security_opt:
      - no-new-privileges:true
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"