# =============================================================================
# FILE: deploy/docker/Dockerfile.langgraph
# =============================================================================
# PURPOSE:
#   Builds the LangGraph Server image for serving the supervisor graph.
# =============================================================================

FROM python:3.12.13-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl git gcc libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy the entire project (includes all source code)
COPY . /app

# Copy requirements from src/core (explicit, but already included in COPY .)
# We keep it to leverage Docker layer caching – requirements.txt changes less often.
COPY src/core/requirements.txt /app/requirements.txt

# Install Python dependencies
RUN pip install --no-cache-dir -r /app/requirements.txt \
    && pip install --no-cache-dir langgraph-cli

# Copy the langgraph.json configuration (optional, not used with uvicorn)
COPY deploy/docker/langgraph.json /app/langgraph.json

# Set working directory to where app.py lives
WORKDIR /app/src/core

# Expose the LangGraph Server port
EXPOSE 8000

# Command to run the LangGraph Server
CMD ["sh", "-c", "cd /app/src/core && uvicorn app:app --host 0.0.0.0 --port 8000"]