# =============================================================================
# FILE: deploy/docker/Dockerfile.langgraph
# =============================================================================
# PURPOSE:
#   Builds the LangGraph Server image for serving the supervisor graph.
# =============================================================================

FROM python:3.12-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    git \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy project files
COPY . /app

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir langgraph-cli

# Copy the langgraph.json configuration
COPY deploy/docker/langgraph.json /app/langgraph.json

# Expose the LangGraph Server port
EXPOSE 8000

# Command to run the LangGraph Server
CMD ["langgraph", "serve", "--host", "0.0.0.0", "--port", "8000"]