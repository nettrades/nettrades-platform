# =============================================================================
# FILE: deploy/docker/Dockerfile.langgraph
# =============================================================================
# PURPOSE:
#   Builds the LangGraph Server image for serving the supervisor graph.
# =============================================================================

FROM python:3.12.13-slim

WORKDIR /app

# Install system dependencies.
# Note: Debian Trixie ships docker.io but NOT docker-compose-plugin.
# We install the Compose v2 plugin binary directly from GitHub instead.
RUN apt-get update && apt-get install -y \
    curl git gcc libpq-dev docker.io \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /usr/local/lib/docker/cli-plugins \
    && curl -SL "https://github.com/docker/compose/releases/download/v5.5.1/docker-compose-linux-x86_64" \
        -o /usr/local/lib/docker/cli-plugins/docker-compose \
    && chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

# Source code is copied wholesale. Two known failure modes on WSL2 and
# Windows-hosted Docker, both observed during the 2026-11-16 session:
#
#   1. COPY layer cache reuse. A source edit under src/core/ sometimes
#      does not invalidate the COPY layer, so the running container keeps
#      the previous file version. Force a rebuild:
#          docker compose build --no-cache langgraph-server
#
#   2. If the change is in the image but the code still does not fire at
#      runtime, check that the import statement is at module scope — the
#      `import json` bug on 2026-11-16 was the manifest override silently
#      failing on every inventory refresh with a NameError caught in the
#      outer try/except.
COPY src/core/ /app/src/core/

# Copy requirements from src/core (explicit)
# We keep it to leverage Docker layer caching – requirements.txt changes less often.
COPY src/core/requirements.txt /app/requirements.txt

# Install Python dependencies
RUN pip install --no-cache-dir -r /app/requirements.txt \
    && pip install --no-cache-dir langgraph-cli

# Copy the langgraph.json configuration (optional, not used with uvicorn)
COPY deploy/docker/langgraph.json /app/langgraph.json

# Set working directory to where app.py lives
WORKDIR /app/src/core

# Expose the LangGraph Server port
EXPOSE 8000

# Command to run the LangGraph Server
CMD ["sh", "-c", "cd /app/src/core && uvicorn app:app --host 0.0.0.0 --port 8000"]