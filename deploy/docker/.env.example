# =============================================================================
# NETTRADES.AI – Marketplace Platform Environment Variables
# =============================================================================
# Copy this file to .env and replace every placeholder with a strong value.
# NEVER commit the real .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Feature Flags – Enable/disable modules based on readiness
# Set to true to enable, false to disable (coming soon features)
# -----------------------------------------------------------------------------

# Core Features (always required)
FEATURE_CORE=true

# GPU Marketplace & Administration
FEATURE_GPU_MARKETPLACE=true
FEATURE_GPU_ADMIN=true

# Routing & Bridge (Hub-and-Spoke)
FEATURE_BRIDGE=true
FEATURE_ROUTER=true

# Self-Improving AI & Training
FEATURE_GOOD_ANSWER=true
FEATURE_SELF_IMPROVING=true
FEATURE_TRAINING=true

# Enterprise Features (coming soon – set to true when ready)
FEATURE_ASK_SOMEONE=false          # ⚠️ Needs view fixes (coming soon)
FEATURE_JOB_MATCHING=false         # ⚠️ Needs integration (coming soon)
FEATURE_LEAD_SCORING=false         # ⚠️ Needs integration (coming soon)
FEATURE_RESEARCH=false             # ⚠️ Needs integration (coming soon)
FEATURE_ONBOARDING=false           # ⚠️ Skeleton only (coming soon)
FEATURE_FAIRNESS_DASHBOARD=false   # ⚠️ Needs UI (coming soon)

# Data & Automation (coming soon)
FEATURE_DATA_COLLECTION=false      # ⚠️ Needs dataset UI (coming soon)
FEATURE_TRIGGERS=false             # ⚠️ Needs workflow editor (coming soon)
FEATURE_LOOPS=false                # ⚠️ Needs visual editor (coming soon)

# External Integrations (coming soon)
FEATURE_EXTERNAL_LLM=false         # ⚠️ Needs provider config UI (coming soon)
FEATURE_WEBHOOKS=false             # ⚠️ Needs webhook editor (coming soon)

# -----------------------------------------------------------------------------
# Emergency Access Configuration
# -----------------------------------------------------------------------------
# Emergency user validity duration in hours (default: 4)
EMERGENCY_ACCESS_DURATION=4
# Enable emergency access audit logging
EMERGENCY_AUDIT_ENABLED=true

# -----------------------------------------------------------------------------
# UV
# If USE_UV=true it uses UV but fall back gracefully to pip if uv fails
# Force pip by simply adding USE_UV=false
# -----------------------------------------------------------------------------
USE_UV=true

# -----------------------------------------------------------------------------
# Domain & Admin
# -----------------------------------------------------------------------------
DOMAIN=changeit
ADMIN_EMAIL=changeit

# -----------------------------------------------------------------------------
# development or production
# -----------------------------------------------------------------------------
ENVIRONMENT=development

# -----------------------------------------------------------------------------
# Default Landing Page (root path)
# Options: odoo, ui, custom
#   odoo   → redirects to /odoo (Odoo homepage)
#   ui     → redirects to http://localhost:3002 (custom UI)
#   custom → serves a static landing page with links (you can edit it later)
# -----------------------------------------------------------------------------
DEFAULT_LANDING_PAGE=odoo

# -----------------------------------------------------------------------------
# HUB URL
# -----------------------------------------------------------------------------
NETTRADES_HUB_URL=https://nettrades.ai

# -----------------------------------------------------------------------------
# PostgreSQL - the password will be in the single quotes like this 'password'
# -----------------------------------------------------------------------------
POSTGRES_PASSWORD=changeit
ADMIN_PASSWORD=changeit

# -----------------------------------------------------------------------------
# Forgejo (Self-hosted Git Server) - the password will be in the single quotes like this 'password'
# -----------------------------------------------------------------------------
FORGEJO_DB_PASSWORD=changeit
FORGEJO_SECRET_KEY=changeit
JWT_SECRET=changeit

# -----------------------------------------------------------------------------
# Prometheus - the password will be in the single quotes like this 'password'
# -----------------------------------------------------------------------------
PROMETHEUS_PASSWORD=changeit

# -----------------------------------------------------------------------------
# Grafana - the password will be in the single quotes like this 'password'
# -----------------------------------------------------------------------------
GRAFANA_PASSWORD=changeit

# -----------------------------------------------------------------------------
# LLM / AI - the password will be in the single quotes like this 'password'
# -----------------------------------------------------------------------------
LLAMA_API_KEY=changeit

# -----------------------------------------------------------------------------
# NVIDIA Dynamo – Primary Inference Engine (replaces GPUStack)
# -----------------------------------------------------------------------------
# API key for Dynamo – used by both Dynamo server and LangGraph to authenticate
DYNAMO_API_KEY=changeit
LLM_BASE_URL=http://dynamo:8000/v1
# Model to use for inference (should match a model available in /models)
MODEL_NAME=deepseek-7b

# For your custom mirror for hugging face models without token         HF_MODEL_MIRROR="https://your-server.com/model.tar.gz"
# HF_MODEL_MIRROR  

# -----------------------------------------------------------------------------
# For OpenAI-compatible models
# -----------------------------------------------------------------------------
OPENAI_API_BASE=${LLM_BASE_URL}
OPENAI_API_KEY=${DYNAMO_API_KEY}

# -----------------------------------------------------------------------------
# Inference Engine Selection
# Options: dynamo-frontend (CPU mock), vllm-gpu, vllm-cpu, sglang, tensorrt-llm, llama-cpp
# -----------------------------------------------------------------------------
INFERENCE_ENGINE=auto
# Override image if needed
VLLM_IMAGE=nvcr.io/nvidia/ai-dynamo/vllm-runtime:1.2.0
VLLM_COMMAND="--model /models/${MODEL_NAME} --tensor-parallel-size 1"
# For CPU vLLM, set VLLM_TARGET_DEVICE=cpu
VLLM_TARGET_DEVICE=cuda   # or cpu

# -----------------------------------------------------------------------------
# LangGraph API Key - used by both LangGraph server and agent-chat-ui
# -----------------------------------------------------------------------------
LANGGRAPH_API_KEY=changeit   # Must be a strong, random string in production
LANGGRAPH_URL=http://langgraph-server:8000

# -----------------------------------------------------------------------------
# LangGraph PostgresSaver (same PostgreSQL cluster as Odoo)
# Production: The ENVIRONMENT=production + DISABLE_AUTH=false combination guarantees security.
# Development: The ENVIRONMENT=development + DISABLE_AUTH=true combination saves you hours of debugging time.
# src/core/app.py – Authentication bypass fixed; DISABLE_AUTH now respects ENVIRONMENT (blocks DISABLE_AUTH=true in production)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://odoo:${POSTGRES_PASSWORD}@postgres:5432/odoo
DISABLE_AUTH=false   # Set to true only for local development

# -----------------------------------------------------------------------------
# Enterprise Connector Configuration (Universal Enterprise Proxy)
# -----------------------------------------------------------------------------
# Choose the backend: odoo, salesforce, sap, oracle
ENTERPRISE_BACKEND=odoo

# Odoo Connector (default)
ODOO_URL=http://odoo:8069
ODOO_DB=odoo
ODOO_USER=1
ODOO_PASSWORD=admin

# Salesforce Connector (optional)
SF_INSTANCE_URL=https://your-instance.salesforce.com
SF_CLIENT_ID=your_client_id
SF_CLIENT_SECRET=your_client_secret
SF_USERNAME=salesforce_user
SF_PASSWORD=salesforce_password

# SAP Connector (optional)
SAP_BASE_URL=https://your-sap-system.com
SAP_CLIENT=100
SAP_USERNAME=sap_user
SAP_PASSWORD=sap_password

# Oracle Connector (optional)
ORACLE_BASE_URL=https://your-oracle-system.com
ORACLE_USERNAME=oracle_user
ORACLE_PASSWORD=oracle_password

# -----------------------------------------------------------------------------
# Odoo Proxy (NEW – replaces mcp-odoo) - the password will be in the single quotes like this 'password'
# -----------------------------------------------------------------------------
# This secret is used by BOTH the langgraph service (as ODOO_API_KEY) and the
# odoo-proxy service (as PROXY_API_KEY). They MUST be the exact same value.
ODOO_API_KEY=changeit
PROXY_API_KEY=changeit
ODOO_PROXY_URL=http://odoo-proxy:8080
USE_ODOO_PROXY=true

# -----------------------------------------------------------------------------
# WireGuard - the password will be in the single quotes like this 'password'
# -----------------------------------------------------------------------------
WIREGUARD_PRIVATE_KEY=changeit
WIREGUARD_PUBLIC_KEY=changeit

# -----------------------------------------------------------------------------
# WireGuard Admin VPN
# -----------------------------------------------------------------------------
WG_ADMIN_PORT=51821
WG_ADMIN_SUBNET=10.10.10.0/24
WG_ADMIN_SERVER_IP=10.10.10.1

# -----------------------------------------------------------------------------
# NETTRADES-UI
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_DOMAIN=https://${DOMAIN}
NEXT_PUBLIC_AUTH_ENABLED=${AUTH_ENABLED:-false}

# -----------------------------------------------------------------------------
# NETTRADES-UI Authentication with Odoo (Odoo OAuth 2.0)
#
# AUTH_ENABLED controls whether the frontend requires login and whether the backend validates tokens. This allows companies to:
#    Use the platform for pure inferencing without authentication (if they trust the network).
#    Enable authentication when they need user-specific governance, token-based access, or limited token usage.
# Additionally, the Odoo OAuth integration allows:
#    Token-based access: Companies can issue limited-use tokens.
#    User-based quotas: The backend can track token usage per user via Odoo.
# -----------------------------------------------------------------------------
# Set AUTH_ENABLED=true to enforce authentication; false to allow anonymous access
AUTH_ENABLED=false

UI_API_KEY=changeit

# Session secret (generate with: openssl rand -base64 32)
SESSION_SECRET=changeit

# Odoo OAuth 2.0 credentials
ODOO_OAUTH_CLIENT_ID=changeit
ODOO_OAUTH_CLIENT_SECRET=changeit
# ODOO_OAUTH_REDIRECT_URI used by nettrades-ui/app/main.py
ODOO_OAUTH_REDIRECT_URI=https://${DOMAIN}/api/auth/callback/odoo
ODOO_PROXY_URL=http://odoo-proxy:8080

# Odoo OAuth endpoints (adapt to your Odoo instance)
ODOO_OAUTH_AUTHORIZE_URL=${ODOO_URL}/restapi/1.0/common/oauth2/authorize
ODOO_OAUTH_TOKEN_URL=${ODOO_URL}/restapi/1.0/common/oauth2/access_token
ODOO_OAUTH_USERINFO_URL=${ODOO_URL}/restapi/1.0/common/oauth2/userinfo

# =============================================================================
# SELF-IMPROVING SERVICE (Fine-Tuning)
# =============================================================================
# These variables configure the self-improving service for continuous learning.
# -----------------------------------------------------------------------------

# Number of episodes to trigger training
THRESHOLD_EPISODES=50

# Minimum quality score for training data (0-10)
THRESHOLD_QUALITY=7.0

# Model to use for fine-tuning
FINE_TUNE_MODEL=deepseek-1.5b

# Fine-tuning method: unsloth, axolotl, or auto
FINE_TUNE_METHOD=unsloth

# Default data classification for episodes
DATA_CLASSIFICATION_DEFAULT=public

# =============================================================================
# CONTAINER RUNTIME CONFIGURATION
# =============================================================================
# These variables control which runtime each service uses.
# Options: (empty = default runc), runsc (gVisor)
#
# gVisor (runsc) is a user-space kernel that provides strong isolation.
# It is recommended for untrusted workloads (home users, freelancers).
# It is NOT recommended for GPU workloads (Dynamo) or I/O-heavy services (PostgreSQL).
#
# Reference: Anthropic uses gVisor for agent sandboxing with egress restricted
# to the API only. GKE Agent Sandbox also uses gVisor for AI agent isolation.
# -----------------------------------------------------------------------------

# Odoo - Trusted governance layer. Always use runc for performance.
RUNTIME_ODOO=

# LangGraph Server - AI agent orchestration.
# Set to "runsc" for untrusted tenants (home users, freelancers)
# Leave empty (runc) for enterprise/trusted tenants
RUNTIME_LANGGRAPH=

# Self-Improving Service - Continuous learning.
# Set to "runsc" for untrusted tenants
RUNTIME_SELF_IMPROVING=

# NETTRADES UI - Frontend.
# Set to "runsc" for untrusted tenants
RUNTIME_UI=

# NVIDIA Dynamo - GPU inference. MUST use runc (gVisor does NOT support GPU passthrough)
RUNTIME_DYNAMO=

# PostgreSQL - Database. MUST use runc (gVisor adds 10-30% I/O overhead)
RUNTIME_POSTGRES=

# Valkey - In-memory store. MUST use runc (performance critical)
RUNTIME_VALKEY=

# LangGraph Server - API proxy. Set to "runsc" for untrusted tenants
RUNTIME_LANGGRAPH_PROXY=

# =============================================================================
# TENANT CONFIGURATION
# =============================================================================
# These variables identify the tenant type for runtime selection.
# -----------------------------------------------------------------------------

# Tenant type: enterprise, freelancer, or home
TENANT_TYPE=enterprise

# Tenant name for identification
TENANT_NAME=default


