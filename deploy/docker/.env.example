# =============================================================================
# NETTRADES.AI – Marketplace Platform Environment Variables
# =============================================================================
# Copy this file to .env and replace every placeholder with a strong value.
# NEVER commit the real .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# UV
# If USE_UV=true it uses UV but fall back gracefully to pip if uv fails
# Force pip by simply adding USE_UV=false
# -----------------------------------------------------------------------------
USE_UV=true

# -----------------------------------------------------------------------------
# Domain & Admin
# -----------------------------------------------------------------------------
DOMAIN=changeit
ADMIN_EMAIL=changeit
ENVIRONMENT=development   # development or production

# -----------------------------------------------------------------------------
# HUB URL
# -----------------------------------------------------------------------------
NETTRADES_HUB_URL=https://nettrades.ai

# -----------------------------------------------------------------------------
# PostgreSQL - the password will be in the single quotes like this 'password'
# -----------------------------------------------------------------------------
POSTGRES_PASSWORD=changeit
ADMIN_PASSWORD=changeit

# -----------------------------------------------------------------------------
# Forgejo (Self-hosted Git Server) - the password will be in the single quotes like this 'password'
# -----------------------------------------------------------------------------
FORGEJO_DB_PASSWORD=changeit
FORGEJO_SECRET_KEY=changeit
JWT_SECRET=changeit

# -----------------------------------------------------------------------------
# Prometheus - the password will be in the single quotes like this 'password'
# -----------------------------------------------------------------------------
PROMETHEUS_PASSWORD=changeit

# -----------------------------------------------------------------------------
# Grafana - the password will be in the single quotes like this 'password'
# -----------------------------------------------------------------------------
GRAFANA_PASSWORD=changeit

# -----------------------------------------------------------------------------
# LLM / AI - the password will be in the single quotes like this 'password'
# -----------------------------------------------------------------------------
LLAMA_API_KEY=changeit

# -----------------------------------------------------------------------------
# NVIDIA Dynamo – Primary Inference Engine (replaces GPUStack)
# -----------------------------------------------------------------------------
# API key for Dynamo – used by both Dynamo server and LangGraph to authenticate
DYNAMO_API_KEY=changeit
LLM_BASE_URL=http://dynamo:8000/v1
# Model to use for inference (should match a model available in /models)
MODEL_NAME=Qwen2.5-1.5B-Instruct

# For OpenAI-compatible models
OPENAI_API_BASE=${LLM_BASE_URL}
OPENAI_API_KEY=${DYNAMO_API_KEY}

# -----------------------------------------------------------------------------
# LangGraph API Key - used by both LangGraph server and agent-chat-ui
# -----------------------------------------------------------------------------
LANGGRAPH_API_KEY=changeit   # Must be a strong, random string in production

# -----------------------------------------------------------------------------
# WireGuard - the password will be in the single quotes like this 'password'
# -----------------------------------------------------------------------------
WIREGUARD_PRIVATE_KEY=changeit
WIREGUARD_PUBLIC_KEY=changeit

# -----------------------------------------------------------------------------
# LangGraph PostgresSaver (same PostgreSQL cluster as Odoo)
# Production: The ENVIRONMENT=production + DISABLE_AUTH=false combination guarantees security.
# Development: The ENVIRONMENT=development + DISABLE_AUTH=true combination saves you hours of debugging time.
# src/core/app.py – Authentication bypass fixed; DISABLE_AUTH now respects ENVIRONMENT (blocks DISABLE_AUTH=true in production)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://odoo:${POSTGRES_PASSWORD}@postgres:5432/odoo
DISABLE_AUTH=false   # Set to true only for local development

# -----------------------------------------------------------------------------
# Odoo Backend
# -----------------------------------------------------------------------------
ODOO_URL=http://odoo:8069
ODOO_DB=odoo
ODOO_USER=1
ODOO_PASSWORD=admin

# -----------------------------------------------------------------------------
# Odoo Proxy (NEW – replaces mcp-odoo) - the password will be in the single quotes like this 'password'
# -----------------------------------------------------------------------------
# This secret is used by BOTH the langgraph service (as ODOO_API_KEY) and the
# odoo-proxy service (as PROXY_API_KEY). They MUST be the exact same value.
ODOO_API_KEY=changeit
PROXY_API_KEY=changeit
ODOO_PROXY_URL=http://odoo-proxy:8080
USE_ODOO_PROXY=true

# -----------------------------------------------------------------------------
# WireGuard Admin VPN
# -----------------------------------------------------------------------------
WG_ADMIN_PORT=51821
WG_ADMIN_SUBNET=10.10.10.0/24
WG_ADMIN_SERVER_IP=10.10.10.1