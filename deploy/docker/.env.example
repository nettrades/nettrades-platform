# =============================================================================
# NETTRADES.AI – Marketplace Platform Environment Variables
# =============================================================================
# Copy this file to .env and replace every placeholder with a strong value.
# NEVER commit the real .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# UV
# If USE_UV=true it uses UV but fall back gracefully to pip if uv fails
# Force pip by simply adding USE_UV=false
# -----------------------------------------------------------------------------
USE_UV=true

# -----------------------------------------------------------------------------
# Domain & Admin
# -----------------------------------------------------------------------------
DOMAIN=changeit
ADMIN_EMAIL=changeit
ENVIRONMENT=development   # development or production

# -----------------------------------------------------------------------------
# HUB URL
# -----------------------------------------------------------------------------
NETTRADES_HUB_URL=https://nettrades.ai

# -----------------------------------------------------------------------------
# PostgreSQL - the password will be in the single quotes like this 'password'
# -----------------------------------------------------------------------------
POSTGRES_PASSWORD=changeit
ADMIN_PASSWORD=changeit

# -----------------------------------------------------------------------------
# Forgejo (Self-hosted Git Server) - the password will be in the single quotes like this 'password'
# -----------------------------------------------------------------------------
FORGEJO_DB_PASSWORD=changeit
FORGEJO_SECRET_KEY=changeit
JWT_SECRET=changeit

# -----------------------------------------------------------------------------
# Prometheus - the password will be in the single quotes like this 'password'
# -----------------------------------------------------------------------------
PROMETHEUS_PASSWORD=changeit

# -----------------------------------------------------------------------------
# Grafana - the password will be in the single quotes like this 'password'
# -----------------------------------------------------------------------------
GRAFANA_PASSWORD=changeit

# -----------------------------------------------------------------------------
# LLM / AI - the password will be in the single quotes like this 'password'
# -----------------------------------------------------------------------------
LLAMA_API_KEY=changeit

# -----------------------------------------------------------------------------
# GPUStack - the password will be in the single quotes like this 'password'
# -----------------------------------------------------------------------------
GPUSTACK_JWT_SECRET=changeit
GPUSTACK_ADMIN_PASSWORD=changeit
LLM_BASE_URL=http://gpustack:8080/v1
GPUSTACK_API_KEY=dummy
# IN PRODUCTION HAVE    GPUSTACK_API_KEY=changeit

# For OpenAI-compatible models
OPENAI_API_BASE=${LLM_BASE_URL}
OPENAI_API_KEY=${GPUSTACK_API_KEY}

# -----------------------------------------------------------------------------
# LangGraph API Key - used by both LangGraph server and agent-chat-ui
# -----------------------------------------------------------------------------
LANGGRAPH_API_KEY=changeit   # Must be a strong, random string in production

# -----------------------------------------------------------------------------
# WireGuard - the password will be in the single quotes like this 'password'
# -----------------------------------------------------------------------------
WIREGUARD_PRIVATE_KEY=changeit
WIREGUARD_PUBLIC_KEY=changeit

# -----------------------------------------------------------------------------
# LangGraph PostgresSaver (same PostgreSQL cluster as Odoo)
# Production: The ENVIRONMENT=production + DISABLE_AUTH=false combination guarantees security.
# Development: The ENVIRONMENT=development + DISABLE_AUTH=true combination saves you hours of debugging time.
# src/core/app.py – Authentication bypass fixed; DISABLE_AUTH now respects ENVIRONMENT (blocks DISABLE_AUTH=true in production)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://odoo:${POSTGRES_PASSWORD}@postgres:5432/odoo
DISABLE_AUTH=false   # Set to true only for local development

# -----------------------------------------------------------------------------
# Odoo Backend
# -----------------------------------------------------------------------------
ODOO_URL=http://odoo:8069
ODOO_DB=odoo
ODOO_USER=1
ODOO_PASSWORD=admin

# -----------------------------------------------------------------------------
# Odoo Proxy (NEW – replaces mcp-odoo) - the password will be in the single quotes like this 'password'
# -----------------------------------------------------------------------------
# This secret is used by BOTH the langgraph service (as ODOO_API_KEY) and the
# odoo-proxy service (as PROXY_API_KEY). They MUST be the exact same value.
ODOO_API_KEY=changeit
PROXY_API_KEY=changeit
ODOO_PROXY_URL=http://odoo-proxy:8080
USE_ODOO_PROXY=true

# -----------------------------------------------------------------------------
# WireGuard Admin VPN
# -----------------------------------------------------------------------------
WG_ADMIN_PORT=51821
WG_ADMIN_SUBNET=10.10.10.0/24
WG_ADMIN_SERVER_IP=10.10.10.1



# =============================================================================
# LANGGRAPH CONFIGURATION
# =============================================================================

# The name of your LangGraph graph/assistant
LANGGRAPH_GRAPH_ID=agent
# UPDATE: Change 'agent' to your actual graph name

# OpenAI API Key (if using OpenAI models)
# OPENAI_API_KEY=sk-...

# LangSmith API Key (optional, for tracing and debugging)
# LANGSMITH_API_KEY=lsv2_...

# Database URL (if using persistent storage)
# DATABASE_URL=postgresql://langgraph:password@postgres:5432/langgraph

# Redis URL (if using caching)
# REDIS_URL=redis://redis:6379


# =============================================================================
# AGENT CHAT UI CONFIGURATION
# =============================================================================

# Which graph to connect to
NEXT_PUBLIC_ASSISTANT_ID=agent
# UPDATE: Match your LANGGRAPH_GRAPH_ID

# URL to LangGraph API
# For development (containers on same network):
NEXT_PUBLIC_API_URL=http://langgraph-server:8000

# For production (through Traefik):
# NEXT_PUBLIC_API_URL=https://nettrades.ai/api

# Auth scheme (if using LangSmith)
# NEXT_PUBLIC_AUTH_SCHEME=langsmith-api-key

# Node environment
NODE_ENV=production
# Change to 'development' for debugging


# =============================================================================
# TRAEFIK CONFIGURATION
# =============================================================================

# Log level (INFO, DEBUG, WARN, ERROR)
TRAEFIK_LOG_LEVEL=INFO

# Enable HTTPS (requires proper certificate setup)
# TRAEFIK_ACME_EMAIL=admin@nettrades.ai
# TRAEFIK_ACME_STORAGE=acme.json

# =============================================================================
# DATABASE CONFIGURATION (if using PostgreSQL)
# =============================================================================

POSTGRES_DB=langgraph
POSTGRES_USER=langgraph
POSTGRES_PASSWORD=secure_password_here
# CHANGE THIS to a strong password!

# =============================================================================
# IMAGE VERSIONS
# =============================================================================

# LangGraph Server image
LANGGRAPH_IMAGE=langgraph-server:latest
# UPDATE: Change to your actual image name/tag

# Agent Chat UI image
AGENT_CHAT_UI_IMAGE=agent-chat-ui:latest
# UPDATE: Change to your actual image name/tag

# Traefik version
TRAEFIK_VERSION=v3.3

# =============================================================================
# OPTIONAL: LETSENCRYPT / HTTPS CONFIGURATION
# =============================================================================

# Email for Let's Encrypt certificate notifications
# LETSENCRYPT_EMAIL=admin@nettrades.ai

# ACME server (use production for real certs)
# ACME_SERVER=https://acme-v02.api.letsencrypt.org/directory
# For testing: ACME_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory
