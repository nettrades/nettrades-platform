# =============================================================================
# FILE: deploy/docker/Dockerfile.copilotkit-frontend
# =============================================================================
# PURPOSE:
#   Builds the CopilotKit frontend from vendored source code.
#   Uses only open-source packages, no account or API key required.
#   No external network fetch during build.
# =============================================================================

FROM node:20-slim AS builder

# Install git only for npm packages that may need it
RUN apt-get update && apt-get install -y git openssh-client && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy the vendored frontend source
COPY deploy/docker/copilotkit-frontend-src/ ./

# Install dependencies and build
RUN npm install -g pnpm && \
    pnpm install && \
    pnpm build

# Production stage
FROM node:20-slim AS runner

WORKDIR /app

# Copy the standalone output and necessary files
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/public ./public

EXPOSE 3000

CMD ["node", "server.js"]