# =============================================================================
# FILE: deploy/docker/Dockerfile.agent-chat-ui
# =============================================================================
# PURPOSE:
#   Builds the agent-chat-ui Next.js application with API Passthrough enabled.
#   API Passthrough is the production pattern where the Next.js server proxies
#   requests to LangGraph, avoiding client-side API keys and CORS issues.
# =============================================================================

FROM node:20-slim AS builder

# Build arguments for environment variables
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_ASSISTANT_ID
ARG NEXT_PUBLIC_SKIP_AUTH
ARG NEXT_PUBLIC_AUTH_SCHEME
ARG NEXT_PUBLIC_LANGGRAPH_API_KEY
# Server-side variables for API Passthrough
ARG LANGGRAPH_API_URL
ARG LANGSMITH_API_KEY

# Install git and openssh-client for cloning
RUN apt-get update && apt-get install -y git openssh-client && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Clone and install agent-chat-ui
RUN git clone https://github.com/langchain-ai/agent-chat-ui.git . \
    && npm install -g pnpm \
    && pnpm install

# Set environment variables before build
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_ASSISTANT_ID=$NEXT_PUBLIC_ASSISTANT_ID
ENV NEXT_PUBLIC_SKIP_AUTH=$NEXT_PUBLIC_SKIP_AUTH
ENV NEXT_PUBLIC_AUTH_SCHEME=$NEXT_PUBLIC_AUTH_SCHEME
ENV NEXT_PUBLIC_LANGGRAPH_API_KEY=$NEXT_PUBLIC_LANGGRAPH_API_KEY
# For API Passthrough, these are used at runtime by the Next.js server
ENV LANGGRAPH_API_URL=$LANGGRAPH_API_URL
ENV LANGSMITH_API_KEY=$LANGSMITH_API_KEY

# Build the Next.js application
RUN pnpm build

# Production stage
FROM node:20-slim AS runner

WORKDIR /app

# Copy the entire built application from builder
COPY --from=builder /app /app

EXPOSE 3000

# Next.js will use the environment variables at runtime for API Passthrough
CMD ["npm", "start"]