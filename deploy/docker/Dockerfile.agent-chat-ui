FROM node:20-slim AS builder

# Build arguments for environment variables
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_ASSISTANT_ID

# Install git and openssh-client for cloning
RUN apt-get update && apt-get install -y git openssh-client && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Clone and install agent-chat-ui
RUN git clone https://github.com/langchain-ai/agent-chat-ui.git . \
    && npm install -g pnpm \
    && pnpm install

# Set environment variables before build
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_ASSISTANT_ID=$NEXT_PUBLIC_ASSISTANT_ID

# Build the Next.js application
RUN pnpm build

# Production stage
FROM node:20-slim AS runner

WORKDIR /app

# Copy the entire built application from builder (includes .next, public, node_modules, etc.)
COPY --from=builder /app /app

EXPOSE 3000
CMD ["npm", "start"]